---
interface Props { isHome: boolean }
const { isHome } = Astro.props;
const home = isHome ? '#' : '/#';
const items = [
  { label: 'Inicio', href: `${home}inicio`, id: 'inicio', current: isHome },
  { label: 'Trabajos', href: `${home}proyectos`, id: 'proyectos', current: !isHome },
  { label: 'Servicios', href: `${home}servicios`, id: 'servicios', current: false },
  { label: 'Contacto', href: `${home}contacto`, id: 'contacto', current: false },
];
---
<nav class="fm-app-tabbar" aria-label="Navegación principal móvil">
  <div class="fm-app-tabbar__inner">
    {items.map((item) => (
      <a
        href={item.href}
        class="fm-app-tabbar__link"
        data-mobile-nav={item.id}
        aria-label={item.label}
        aria-current={item.current ? 'page' : undefined}
      >
        <span class="fm-app-tabbar__icon" aria-hidden="true">
          {item.id === 'inicio' ? (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/></svg>
          ) : item.id === 'proyectos' ? (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 10v10"/></svg>
          ) : item.id === 'servicios' ? (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
          ) : (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v12H8l-4 3z"/><path d="M8 10h8M8 13h5"/></svg>
          )}
        </span>
        <span class="fm-app-tabbar__label">{item.label}</span>
      </a>
    ))}
  </div>
</nav>
<script>
  // Realce basado en la sección visible, sin afectar navegación nativa.
  const bar = document.querySelector('.fm-app-tabbar');
  if (bar && location.pathname === '/') {
    const links = [...bar.querySelectorAll<HTMLAnchorElement>('[data-mobile-nav]')];
    const sections = links.map((link) => ({
      link,
      section: document.getElementById(link.dataset.mobileNav ?? ''),
    })).filter((item): item is { link: HTMLAnchorElement; section: HTMLElement } => item.section !== null);
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(() => {
        let active = sections[0];
        for (const item of sections) {
          if (item.section.getBoundingClientRect().top <= window.innerHeight * 0.48) active = item;
        }
        links.forEach((link) => {
          if (link === active.link) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      }, { threshold: [0, 0.1, 0.5] });
      sections.forEach(({ section }) => observer.observe(section));
    }
  }
</script>
