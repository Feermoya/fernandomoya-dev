---
interface Props { isHome: boolean }
const { isHome } = Astro.props;
const home = isHome ? '#' : '/#';
const items = [
  { label: 'Inicio', href: `${home}inicio`, id: 'inicio', current: isHome },
  { label: 'Trabajos', href: `${home}proyectos`, id: 'proyectos', current: !isHome },
  { label: 'Servicios', href: `${home}servicios`, id: 'servicios', current: false },
  { label: 'Contacto', href: `${home}contacto`, id: 'contacto', current: false },
];
---
<nav class="fm-app-tabbar" aria-label="Navegación principal móvil">
  <div class="fm-app-tabbar__inner">
    {items.map((item) => (
      <a
        href={item.href}
        class="fm-app-tabbar__link"
        data-mobile-nav={item.id}
        aria-label={item.label}
        aria-current={item.current ? 'location' : undefined}
      >
        <span class="fm-app-tabbar__icon" aria-hidden="true">
          {item.id === 'inicio' ? (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/></svg>
          ) : item.id === 'proyectos' ? (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 10v10"/></svg>
          ) : item.id === 'servicios' ? (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
          ) : (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v12H8l-4 3z"/><path d="M8 10h8M8 13h5"/></svg>
          )}
        </span>
        <span class="fm-app-tabbar__label">{item.label}</span>
      </a>
    ))}
  </div>
</nav>
<script>
  function initMobileNavigation() {
    const bar = document.querySelector<HTMLElement>('.fm-app-tabbar');
    if (!bar || bar.dataset.initialized === 'true') return;
    bar.dataset.initialized = 'true';

    const links = Array.from(bar.querySelectorAll<HTMLAnchorElement>('[data-mobile-nav]'));
    const setActive = (id: string) => {
      for (const link of links) {
        if (link.dataset.mobileNav === id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };

    if (window.location.pathname !== '/') {
      setActive('proyectos');
      return;
    }

    const sections = links
      .map((link) => ({ id: link.dataset.mobileNav ?? '', section: document.getElementById(link.dataset.mobileNav ?? '') }))
      .filter((entry): entry is { id: string; section: HTMLElement } => entry.section !== null);

    if (!sections.length) return;
    let raf = 0;
    const sync = () => {
      raf = 0;
      const anchor = Math.min(window.innerHeight * 0.44, 280);
      let active = sections[0].id;
      for (const { id, section } of sections) {
        if (section.getBoundingClientRect().top <= anchor) active = id;
      }
      setActive(active);
    };
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(sync);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    window.addEventListener('hashchange', schedule);
    bar.addEventListener('click', schedule);
    schedule();
  }

  initMobileNavigation();
  document.addEventListener('astro:page-load', initMobileNavigation);
</script>
