---
import '@/styles/footer.css';
import { site } from '@/data/site';

const year = new Date().getFullYear();
const mailto = `mailto:${site.email}`;
const isHome = Astro.url.pathname === '/';

function sectionHref(id: string): string {
  return isHome ? `#${id}` : `/#${id}`;
}

const topHref = isHome ? '#inicio' : '#main';

const navLinks = [
  { href: sectionHref('proyectos'), label: 'Trabajo' },
  { href: sectionHref('proceso'), label: 'Proceso' },
  { href: sectionHref('sobre-mi'), label: 'Sobre mí' },
  { href: sectionHref('contacto'), label: 'Contacto' },
] as const;

const seoLinks = [
  { href: '/diseno-web-mendoza', label: 'Diseño web Mendoza' },
  { href: '/paginas-web-para-negocios', label: 'Páginas web para negocios' },
  { href: '/landing-page-para-negocios', label: 'Landing page para negocios' },
  { href: '/desarrollo-web-en-espanol', label: 'Desarrollo web en español' },
] as const;
---

<footer class="site-footer">
  <div class="container-page site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href={sectionHref('inicio')} class="site-footer__brand-mark">
          <span class="site-footer__brand-monogram" aria-hidden="true">FM</span>
          <span class="site-footer__brand-name">{site.name}</span>
        </a>
        <p class="site-footer__tagline">
          Diseño webs para negocios que necesitan comunicar mejor lo que hacen.
        </p>
      </div>

      <div class="site-footer__columns">
        <nav class="site-footer__column site-footer__column--navigation" aria-label="Navegación del sitio">
          <p class="site-footer__label">Navegación</p>
          <ul class="site-footer__list">
            {
              navLinks.map((link) => (
                <li>
                  <a href={link.href} class="site-footer__link">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="site-footer__column site-footer__column--contact">
          <p class="site-footer__label">Contacto</p>
          <ul class="site-footer__list">
            <li>
              <a
                href={site.social.whatsapp}
                class="site-footer__link"
                target="_blank"
                rel="noopener noreferrer"
              >
                WhatsApp
              </a>
            </li>
            <li>
              <a href={mailto} class="site-footer__link" aria-label={`Enviar correo a ${site.email}`}>
                <span class="site-footer__email-short">Email</span>
                <span class="site-footer__email-full">{site.email}</span>
              </a>
            </li>
            <li>
              <span class="site-footer__meta">{site.location}</span>
            </li>
          </ul>
        </div>

        <nav class="site-footer__column site-footer__column--services" aria-label="Servicios">
          <p class="site-footer__label">Servicios</p>
          <ul class="site-footer__list site-footer__list--services">
            {
              seoLinks.map((link) => (
                <li>
                  <a href={link.href} class="site-footer__link">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">© {year} {site.name}</p>
      <a href={topHref} class="site-footer__top-link">
        Volver arriba <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>
