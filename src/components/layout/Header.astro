---
import SiteHeader from '@/components/react/SiteHeader';
import { site } from '@/data/site';

const isHome = Astro.url.pathname === '/';

function sectionHref(id: string): string {
  return isHome ? `#${id}` : `/#${id}`;
}

const links = [
  { href: sectionHref('proyectos'), label: 'Proyectos' },
  { href: sectionHref('sobre-mi'), label: 'Sobre mí' },
] as const;
---

<SiteHeader
  client:idle
  siteName={site.name}
  links={links}
  logoHref={isHome ? '#inicio' : '/'}
  ctaHref={sectionHref('contacto')}
  ctaLabel="Contame tu idea"
/>
