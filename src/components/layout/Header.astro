---
import SiteHeader from '@/components/react/SiteHeader';
import { site } from '@/data/site';

const isHome = Astro.url.pathname === '/';

function sectionHref(id: string): string {
  return isHome ? `#${id}` : `/#${id}`;
}

const links = [
  { href: sectionHref('proyectos'), label: 'Proyectos' },
  { href: sectionHref('sobre-mi'), label: 'Sobre mí' },
] as const;
---

<header class="pf-header">
  <a class="pf-header__name" href={isHome ? '#inicio' : '/'}>{site.name}</a>
  <nav class="pf-header__nav" aria-label="Secciones">
    <a class="pf-header__link" href={sectionHref('proyectos')}>Trabajos</a>
    <a class="pf-header__link" href={sectionHref('contacto')}>Contacto</a>
  </nav>
</header>

<SiteHeader
  client:media="(min-width: 768px)"
  siteName={site.name}
  links={links}
  logoHref={isHome ? '#inicio' : '/'}
  ctaHref={sectionHref('contacto')}
  ctaLabel="Contame tu idea"
/>
