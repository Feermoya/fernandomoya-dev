<div id="fm-splash" class="fm-splash" transition:persist="fm-splash" role="status" aria-label="Cargando" aria-live="polite">
  <div class="fm-splash-glow" aria-hidden="true"></div>

  <div class="fm-splash-inner">
    <span class="site-logo-fm fm-splash-logo" aria-label="FM">
      <span class="site-logo-fm__letter">F</span>
      <span class="site-logo-fm__letter">M</span>
    </span>
  </div>

  <div class="fm-splash-bar" aria-hidden="true">
    <span class="fm-splash-bar-fill"></span>
  </div>
</div>

<style>
  #fm-splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--fm-bg-base, #070707);
    overflow: hidden;
    transition:
      opacity 0.42s ease,
      visibility 0s linear 0.42s;
  }

  #fm-splash.fm-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  #fm-splash.fm-gone {
    display: none;
  }

  .fm-splash-glow {
    display: none;
  }

  .fm-splash-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fm-splash-logo {
    font-size: clamp(3.25rem, 14vw, 5.5rem);
    opacity: 0;
    animation: fm-splash-logo-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes fm-splash-logo-in {
    from {
      opacity: 0;
      transform: scale(0.94) translateY(6px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .fm-splash-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: rgba(245, 240, 232, 0.08);
  }

  .fm-splash-bar-fill {
    display: block;
    height: 100%;
    width: 0;
    background: var(--fm-bg-ivory, #f5f0e8);
    animation: fm-splash-progress 0.9s cubic-bezier(0.4, 0, 0.2, 1) forwards 0.08s;
  }

  @keyframes fm-splash-progress {
    to {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fm-splash-logo {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .fm-splash-bar-fill {
      animation: none;
      width: 100%;
    }
  }
</style>

<script>
  const MIN_VISIBLE_MS = 720;
  const MAX_WAIT_MS = 1300;
  const startTime = performance.now();
  let initialSplashBooted = false;
  let pageLoadCount = 0;

  function closeSplash(immediate = false) {
    const splash = document.getElementById('fm-splash');
    if (!splash || splash.classList.contains('fm-hidden')) return;
    const reduce = immediate || window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    splash.classList.add('fm-hidden');
    setTimeout(() => splash.classList.add('fm-gone'), reduce ? 0 : 440);
    document.documentElement.style.overflow = '';
  }

  function scheduleClose() {
    const elapsed = performance.now() - startTime;
    const remaining = Math.max(0, MIN_VISIBLE_MS - elapsed);
    setTimeout(closeSplash, remaining);
  }

  function bootInitialSplash() {
    if (initialSplashBooted) return;
    initialSplashBooted = true;

    if ('fonts' in document) {
      document.fonts.load('400 1em "Instrument Serif"').catch(() => {});
    }

    if (document.readyState === 'complete') {
      scheduleClose();
    } else {
      window.addEventListener('load', scheduleClose, { once: true });
      setTimeout(closeSplash, MAX_WAIT_MS);
    }
  }

  bootInitialSplash();

  document.addEventListener('astro:before-preparation', () => {
    closeSplash(true);
  });

  document.addEventListener('astro:page-load', () => {
    pageLoadCount += 1;
    if (pageLoadCount > 1) {
      closeSplash(true);
    }
  });
</script>
