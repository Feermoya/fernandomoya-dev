<div id="fm-splash" class="fm-splash" role="status" aria-label="Cargando" aria-live="polite">
  <div class="fm-splash-glow" aria-hidden="true"></div>

  <div class="fm-splash-inner">
    <span class="site-logo-fm fm-splash-logo" aria-label="FM">
      <span class="site-logo-fm__letter">F</span>
      <span class="site-logo-fm__letter">M</span>
    </span>
  </div>

  <div class="fm-splash-bar" aria-hidden="true">
    <span class="fm-splash-bar-fill"></span>
  </div>
</div>

<style>
  #fm-splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #050818;
    overflow: hidden;
    transition:
      opacity 0.42s ease,
      visibility 0s linear 0.42s;
  }

  #fm-splash.fm-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  #fm-splash.fm-gone {
    display: none;
  }

  .fm-splash-glow {
    position: absolute;
    inset: 0;
    margin: auto;
    width: min(420px, 70vw);
    height: min(420px, 70vw);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(96, 165, 250, 0.14) 0%,
      rgba(109, 40, 217, 0.06) 45%,
      transparent 70%
    );
    pointer-events: none;
  }

  .fm-splash-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fm-splash-logo {
    font-size: clamp(3.25rem, 14vw, 5.5rem);
    opacity: 0;
    animation: fm-splash-logo-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes fm-splash-logo-in {
    from {
      opacity: 0;
      transform: scale(0.94) translateY(6px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .fm-splash-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: rgba(255, 255, 255, 0.05);
  }

  .fm-splash-bar-fill {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, #60a5fa, #a78bfa);
    animation: fm-splash-progress 0.9s cubic-bezier(0.4, 0, 0.2, 1) forwards 0.08s;
  }

  @keyframes fm-splash-progress {
    to {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fm-splash-logo {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .fm-splash-bar-fill {
      animation: none;
      width: 100%;
    }
  }
</style>

<script>
  const MIN_VISIBLE_MS = 720;
  const MAX_WAIT_MS = 1300;
  const startTime = performance.now();

  function closeSplash() {
    const splash = document.getElementById('fm-splash');
    if (!splash || splash.classList.contains('fm-hidden')) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    splash.classList.add('fm-hidden');
    setTimeout(() => splash.classList.add('fm-gone'), reduce ? 80 : 440);
    document.documentElement.style.overflow = '';
  }

  function scheduleClose() {
    const elapsed = performance.now() - startTime;
    const remaining = Math.max(0, MIN_VISIBLE_MS - elapsed);
    setTimeout(closeSplash, remaining);
  }

  if ('fonts' in document) {
    document.fonts.load('900 1em Nunito').catch(() => {});
  }

  if (document.readyState === 'complete') {
    scheduleClose();
  } else {
    window.addEventListener('load', scheduleClose, { once: true });
    setTimeout(closeSplash, MAX_WAIT_MS);
  }

  document.addEventListener('astro:before-preparation', () => {
    const splash = document.getElementById('fm-splash');
    if (splash) splash.classList.add('fm-gone');
    document.documentElement.style.overflow = '';
  });
</script>
