---
import '@/styles/about.css';
import { getImage } from 'astro:assets';
import profilePhoto from '@/assets/profile.png';
import { site } from '@/data/site';

const profile = await getImage({
  src: profilePhoto,
  widths: [360, 540, 720, 960],
  sizes: '(min-width: 1024px) 38vw, 90vw',
  format: 'webp',
  quality: 80,
});
---

<section id="sobre-mi" class="about-section" aria-labelledby="about-heading">
  <div class="container-page about-section__inner">
    <div class="about-section__copy" data-about-copy>
      <p class="about-section__eyebrow">SOBRE MÍ</p>

      <h2 id="about-heading" class="about-section__title">
        Una web puede verse bien
        <span>y seguir sin decir nada.</span>
      </h2>

      <div class="about-section__body">
        <p class="about-section__text">
          Soy Fernando, desarrollador frontend y diseñador web. Trabajo con empresas,
          profesionales y marcas que necesitan mejorar la forma en la que se presentan online.
        </p>
      </div>


      <div class="about-section__actions">
        <a href="#contacto" class="about-section__cta">Contame tu proyecto</a>
        <a href="#proyectos" class="about-section__link">Ver proyectos</a>
      </div>
    </div>

    <figure class="about-section__photo" data-about-photo>
      <div class="about-section__photo-frame">
        <img
          src={profile.src}
          srcset={profile.srcSet.attribute}
          alt={`Retrato de ${site.name}`}
          width={profile.attributes.width ?? 960}
          height={profile.attributes.height ?? 1200}
          loading="lazy"
          decoding="async"
          sizes="(min-width: 1024px) 38vw, 90vw"
          class="about-section__photo-image"
        />
      </div>
    </figure>
  </div>
</section>

<script>
  function initAboutReveal() {
    const section = document.querySelector('.about-section');
    if (!(section instanceof HTMLElement)) return;
    if (section.dataset.observed === 'true') return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      section.classList.add('is-visible');
      return;
    }

    section.dataset.observed = 'true';
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          section.classList.add('is-visible');
          observer.disconnect();
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
    );
    observer.observe(section);
  }

  initAboutReveal();
  document.addEventListener('astro:page-load', () => {
    const section = document.querySelector('.about-section');
    if (section instanceof HTMLElement) {
      section.dataset.observed = '';
      section.classList.remove('is-visible');
    }
    initAboutReveal();
  });
</script>
