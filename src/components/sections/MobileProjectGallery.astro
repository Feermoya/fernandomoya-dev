---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { isCaseStudyId } from '@/data/case-studies';
import { getProjectCover } from '@/utils/images';
import { byOrderThenDate } from '@/utils/sort';

const entries = (await getCollection('projects')).sort(byOrderThenDate);

const projects = (
  await Promise.all(
    entries.map(async (entry) => {
      const cover = getProjectCover(entry.data.cover);
      if (!cover) return null;
      const image = await getImage({
        src: cover,
        widths: [480, 720, 960],
        sizes: '(max-width: 767px) 100vw, 720px',
        format: 'webp',
        quality: 76,
      });
      const name = entry.data.client ?? entry.data.title;
      const caseUrl = isCaseStudyId(entry.id) ? `/proyectos/${entry.id}` : null;
      return {
        id: entry.id,
        name,
        type: entry.data.projectType,
        text: entry.data.description,
        href: caseUrl ?? entry.data.links.live,
        external: !caseUrl,
        action: caseUrl ? 'Ver proyecto' : 'Visitar sitio',
        src: image.src,
        srcSet: image.srcSet.attribute,
        width: image.attributes.width ?? 720,
        height: image.attributes.height ?? 450,
        alt: `Captura del sitio de ${name}`,
      };
    }),
  )
).filter((item) => item !== null);

const [lead, ...rest] = projects;

const rows: (typeof rest)[] = [];
for (let index = 0; index < rest.length; index += 2) {
  rows.push(rest.slice(index, index + 2));
}
---

<section class="pf-work pf-section pf-wrap" aria-labelledby="pf-work-title">
  <h2 id="pf-work-title" class="pf-title">Trabajos</h2>
  {
    lead ? (
      <ol class="pf-work__list">
        <li>
          <a
            class="pf-card pf-card--lead"
            href={lead.href}
            {...(lead.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <span class="pf-card__media">
              <img
                src={lead.src}
                srcset={lead.srcSet}
                width={lead.width}
                height={lead.height}
                alt={lead.alt}
                sizes="100vw"
                loading="eager"
                decoding="async"
              />
            </span>
            <span class="pf-card__body">
              <span class="pf-card__title">{lead.name}</span>
              <span class="pf-meta">{lead.type}</span>
              <span class="pf-card__text">{lead.text}</span>
              <span class="pf-card__action">{lead.action}</span>
            </span>
          </a>
        </li>
        {
          rows.map((row) =>
            row.length === 2 ? (
              <li>
                <div class="pf-grid">
                  {row.map((project) => (
                    <a
                      class="pf-card pf-card--pair"
                      href={project.href}
                      {...(project.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                      <span class="pf-card__media">
                        <img
                          src={project.src}
                          srcset={project.srcSet}
                          width={project.width}
                          height={project.height}
                          alt={project.alt}
                          sizes="50vw"
                          loading="lazy"
                          decoding="async"
                        />
                      </span>
                      <span class="pf-card__body">
                        <span class="pf-card__title">{project.name}</span>
                        <span class="pf-meta">{project.type}</span>
                        <span class="pf-card__text">{project.text}</span>
                        <span class="pf-card__action">{project.action}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </li>
            ) : (
              row.map((project) => (
                <li>
                  <a
                    class="pf-card pf-card--lead"
                    href={project.href}
                    {...(project.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    <span class="pf-card__media">
                      <img
                        src={project.src}
                        srcset={project.srcSet}
                        width={project.width}
                        height={project.height}
                        alt={project.alt}
                        sizes="100vw"
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                    <span class="pf-card__body">
                      <span class="pf-card__title">{project.name}</span>
                      <span class="pf-meta">{project.type}</span>
                      <span class="pf-card__text">{project.text}</span>
                      <span class="pf-card__action">{project.action}</span>
                    </span>
                  </a>
                </li>
              ))
            ),
          )
        }
      </ol>
    ) : null
  }
</section>
