---
import { getImage } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getProjectCover } from '@/utils/images';
import { byOrderThenDate } from '@/utils/sort';

const all = await getCollection('projects');
const clients = all.filter((p) => p.data.kind === 'client').sort(byOrderThenDate);
const own = all.filter((p) => p.data.kind === 'own').sort(byOrderThenDate);

type ProjectCardData = {
  id: string;
  title: string;
  projectType: string;
  coverSrc: string | null;
  live: string;
};

async function toCardData(p: CollectionEntry<'projects'>): Promise<ProjectCardData> {
  const cover = getProjectCover(p.data.cover);
  let coverSrc: string | null = null;
  if (cover) {
    coverSrc = (await getImage({ src: cover, width: 1200 })).src;
  }
  return {
    id: p.id,
    title: p.data.title,
    projectType: p.data.projectType,
    coverSrc,
    live: p.data.links.live,
  };
}

const ordered = [...clients, ...own];
const projectCards = await Promise.all(ordered.map(toCardData));
---

<section
  id="proyectos"
  class="home-section-light relative border-t border-slate-200/70 py-10 sm:py-14"
  aria-labelledby="projects-heading"
>
  <div class="container-page" data-projects-section>
    <div class="max-w-2xl">
      <h2 id="projects-heading" class="home-section-title">
        Sitios publicados
      </h2>
      <div class="home-section-accent-line" aria-hidden="true"></div>
    </div>

    <div class="projects-showcase mt-6 sm:mt-8">
      {
        projectCards.map((item, idx) => (
          <a
            href={item.live}
            target="_blank"
            rel="noopener noreferrer"
            class="project-showcase-card"
            data-reveal
            style={`--stagger-index:${idx};`}
          >
            <div class="project-showcase-card__media">
              {item.coverSrc ? (
                <img
                  src={item.coverSrc}
                  alt={`Captura de ${item.title}`}
                  width="1200"
                  height="900"
                  loading="lazy"
                  decoding="async"
                  class="project-showcase-card__image"
                  sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 320px"
                />
              ) : (
                <div class="project-showcase-card__placeholder" aria-hidden="true" />
              )}
            </div>

            <div class="project-showcase-card__body">
              <span class="project-showcase-card__badge">{item.projectType}</span>
              <h3 class="project-showcase-card__title">{item.title}</h3>
              <span class="project-showcase-card__cta">
                Ver proyecto
                <span class="project-showcase-card__cta-arrow" aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  const section = document.querySelector('[data-projects-section]');
  if (section) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cards = Array.from(section.querySelectorAll('[data-reveal]'));

    if (reduceMotion) {
      cards.forEach((card) => card.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -32px 0px' },
      );
      cards.forEach((card) => observer.observe(card));
    }
  }
</script>

<style>
  .projects-showcase {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .projects-showcase {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem;
    }
  }

  @media (min-width: 1024px) {
    .projects-showcase {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  @media (min-width: 1280px) {
    .projects-showcase {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .project-showcase-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid rgb(15 23 42 / 0.08);
    background: #ffffff;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 10px 28px rgb(15 23 42 / 0.05);
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.45s ease,
      transform 0.45s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
    transition-delay: calc(var(--stagger-index, 0) * 45ms);
    -webkit-tap-highlight-color: transparent;
  }

  .project-showcase-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .project-showcase-card__media {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 9.5rem;
    padding: 0.5rem 0.65rem;
    background: rgb(248 250 252);
    border-bottom: 1px solid rgb(15 23 42 / 0.05);
  }

  @media (min-width: 640px) {
    .project-showcase-card__media {
      height: 10rem;
      padding: 0.55rem 0.7rem;
    }
  }

  .project-showcase-card__image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .project-showcase-card__placeholder {
    width: 100%;
    height: 100%;
    border-radius: 0.5rem;
    background: linear-gradient(135deg, rgb(226 232 240), rgb(241 245 249));
  }

  .project-showcase-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding: 0.75rem 0.85rem 0.85rem;
  }

  .project-showcase-card__badge {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid rgb(226 232 240);
    padding: 0.18rem 0.45rem;
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgb(100 116 139);
    transition: border-color 0.25s ease, color 0.25s ease;
  }

  .project-showcase-card__title {
    margin: 0;
    font-family: 'Plus Jakarta Sans', var(--font-primary);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: rgb(15 23 42);
    transition: color 0.25s ease;
  }

  .project-showcase-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: auto;
    padding-top: 0.15rem;
    font-size: 0.6875rem;
    font-weight: 600;
    color: rgb(100 116 139);
    transition: color 0.25s ease, gap 0.25s ease;
  }

  .project-showcase-card__cta-arrow {
    display: inline-block;
    transition: transform 0.25s ease;
  }

  .project-showcase-card:focus-visible {
    outline: 2px solid rgb(45 91 227 / 0.45);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .project-showcase-card:hover {
      transform: translateY(-3px);
      border-color: rgb(15 23 42 / 0.12);
      box-shadow: 0 16px 36px rgb(15 23 42 / 0.08);
    }

    .project-showcase-card.is-visible:hover {
      transform: translateY(-3px);
    }

    .project-showcase-card:hover .project-showcase-card__badge {
      border-color: rgb(45 91 227 / 0.22);
      color: rgb(71 85 105);
    }

    .project-showcase-card:hover .project-showcase-card__title {
      color: rgb(45 91 227);
    }

    .project-showcase-card:hover .project-showcase-card__cta {
      color: rgb(45 91 227);
      gap: 0.4rem;
    }

    .project-showcase-card:hover .project-showcase-card__cta-arrow {
      transform: translateX(2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-showcase-card,
    .project-showcase-card__badge,
    .project-showcase-card__title,
    .project-showcase-card__cta,
    .project-showcase-card__cta-arrow {
      transition: none !important;
      transition-delay: 0s !important;
    }

    .project-showcase-card:hover {
      transform: none;
    }
  }
</style>
