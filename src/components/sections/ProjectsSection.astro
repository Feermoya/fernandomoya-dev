---
import '@/styles/projects.css';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import FeaturedProjects from '@/components/react/FeaturedProjects';
import type { FeaturedProjectData } from '@/components/react/FeaturedProject';
import type { ArchiveProjectData } from '@/components/react/FeaturedProjects';
import { getProjectCover } from '@/utils/images';
import { projectListLabel } from '@/utils/project-label';
import { byOrderThenDate } from '@/utils/sort';
import { isCaseStudyId } from '@/data/case-studies';

const SELECTED_IDS = [
  'mendoza-insights',
  'hema',
  'giacomelli-seguros',
  'poletino-servicios',
] as const;

const FEATURED_COPY: Record<
  (typeof SELECTED_IDS)[number],
  {
    number: string;
    typeLine: string;
    phrase: string;
    theme: FeaturedProjectData['theme'];
    mediaPosition: 'left' | 'right';
  }
> = {
  'mendoza-insights': {
    number: '01',
    typeLine: 'Producto digital inmobiliario',
    phrase: 'Datos complejos, presentados con claridad.',
    theme: 'mendoza',
    mediaPosition: 'right',
  },
  hema: {
    number: '02',
    typeLine: 'Laboratorio genético · Sitio institucional',
    phrase: 'Complejidad médica, explicada con claridad.',
    theme: 'hema',
    mediaPosition: 'left',
  },
  'giacomelli-seguros': {
    number: '03',
    typeLine: 'Seguros · Sitio institucional',
    phrase: 'Una empresa familiar, llevada al presente.',
    theme: 'giacomelli',
    mediaPosition: 'right',
  },
  'poletino-servicios': {
    number: '04',
    typeLine: 'Industria · Servicios y maquinaria',
    phrase: 'Maquinaria real. Comunicación directa.',
    theme: 'poletino',
    mediaPosition: 'left',
  },
};

function domainFromLive(url: string): string {
  return new URL(url).hostname.replace(/^www\./, '');
}

const all = await getCollection('projects');
const byId = new Map(all.map((entry) => [entry.id, entry]));

async function toFeaturedData(id: (typeof SELECTED_IDS)[number]): Promise<FeaturedProjectData> {
  const entry = byId.get(id);
  if (!entry) throw new Error(`Proyecto seleccionado no encontrado: ${id}`);

  const copy = FEATURED_COPY[id];
  const cover = getProjectCover(entry.data.cover);
  if (!cover) throw new Error(`Portada no encontrada para ${id}`);

  const optimized = await getImage({
    src: cover,
    widths: [640, 960, 1280],
    sizes: '(min-width: 1280px) 62vw, (min-width: 1024px) 58vw, 100vw',
    format: 'webp',
  });
  const client = entry.data.client ?? entry.data.title;
  const listLabel = projectListLabel(entry.data);
  const live = entry.data.links.live;

  return {
    id,
    number: copy.number,
    client,
    listLabel,
    typeLine: copy.typeLine,
    phrase: copy.phrase,
    domain: domainFromLive(live),
    live,
    caseUrl: `/proyectos/${id}`,
    coverSrc: optimized.src,
    coverSrcSet: optimized.srcSet.attribute,
    coverWidth: optimized.attributes.width ?? 1280,
    coverHeight: optimized.attributes.height ?? 800,
    alt: `Captura del sitio web de ${client}`,
    theme: copy.theme,
    mediaPosition: copy.mediaPosition,
  };
}

const featured = await Promise.all(SELECTED_IDS.map(toFeaturedData));

const archiveSource = all
  .filter((entry) => !SELECTED_IDS.includes(entry.id as (typeof SELECTED_IDS)[number]))
  .sort(byOrderThenDate);

const archive: ArchiveProjectData[] = archiveSource.map((entry, index) => ({
  id: entry.id,
  number: String(index + SELECTED_IDS.length + 1).padStart(2, '0'),
  label: projectListLabel(entry.data),
  live: entry.data.links.live,
  caseUrl: isCaseStudyId(entry.id) ? `/proyectos/${entry.id}` : undefined,
}));
---

<section id="proyectos" class="projects-editorial" aria-labelledby="projects-heading">
  <div class="projects-editorial__intro container-page">
    <p class="projects-editorial__eyebrow">TRABAJO SELECCIONADO</p>
    <h2 id="projects-heading" class="projects-editorial__title">
      No hago webs<br aria-hidden="true" />
      para llenar espacio.
    </h2>
    <p class="projects-editorial__lead">
      Cada proyecto parte de un problema distinto.<br aria-hidden="true" />
      La solución también debería serlo.
    </p>
  </div>

  <FeaturedProjects client:visible featured={featured} archive={archive} />
</section>
