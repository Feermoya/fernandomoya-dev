---
import '@/styles/projects.css';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import FeaturedProjectsList from '@/components/sections/FeaturedProjectsList.astro';
import type { ArchiveProjectData, FeaturedProjectData } from '@/types/featured-project';
import { getProjectCover } from '@/utils/images';
import { projectListLabel } from '@/utils/project-label';
import { byOrderThenDate } from '@/utils/sort';
import { isCaseStudyId } from '@/data/case-studies';

const SELECTED_IDS = [
  'avellaneda-automotores',
  'mendoza-insights',
  'giacomelli-seguros',
  'hema',
] as const;

const FEATURED_COPY: Record<
  (typeof SELECTED_IDS)[number],
  Omit<
    FeaturedProjectData,
    | 'id'
    | 'client'
    | 'listLabel'
    | 'domain'
    | 'live'
    | 'caseUrl'
    | 'coverSrc'
    | 'coverSrcSet'
    | 'coverWidth'
    | 'coverHeight'
  >
> = {
  'avellaneda-automotores': {
    number: '01',
    category: 'Catálogo web administrable',
    headline: 'Un catálogo listo para vender todos los días.',
    summary:
      'Diseño y desarrollo de un catálogo online para publicar, editar, reservar y vender vehículos cada día.',
    theme: 'avellaneda',
    mediaPosition: 'right',
    alt: 'Catálogo web administrable de Avellaneda Automotores con fichas individuales de vehículos',
  },
  'mendoza-insights': {
    number: '02',
    category: 'Producto digital inmobiliario',
    headline: 'Datos inmobiliarios claros de leer.',
    summary:
      'Diseño de una plataforma con indicadores, valuaciones y análisis del mercado inmobiliario de Mendoza.',
    theme: 'mendoza',
    mediaPosition: 'left',
    alt: 'Plataforma Mendoza Insights con indicadores y análisis del mercado inmobiliario',
  },
  'giacomelli-seguros': {
    number: '03',
    category: 'Sitio institucional para seguros',
    headline: 'Seguros explicados con claridad.',
    summary:
      'Rediseño del sitio de una productora de seguros para explicar servicios y generar consultas.',
    theme: 'giacomelli',
    mediaPosition: 'right',
    alt: 'Sitio institucional de Giacomelli Seguros con sus servicios y vías de contacto',
  },
  hema: {
    number: '04',
    category: 'Sitio institucional médico',
    headline: 'Información médica fácil de entender.',
    summary:
      'Diseño y desarrollo de un sitio para comunicar estudios genéticos, servicios médicos y contenidos de prevención.',
    theme: 'hema',
    mediaPosition: 'left',
    alt: 'Sitio web de HEMA con información sobre estudios genéticos y servicios médicos',
  },
};

function domainFromLive(url: string): string {
  return new URL(url).hostname.replace(/^www\./, '');
}

const all = await getCollection('projects');
const byId = new Map(all.map((entry) => [entry.id, entry]));

async function toFeaturedData(id: (typeof SELECTED_IDS)[number]): Promise<FeaturedProjectData> {
  const entry = byId.get(id);
  if (!entry) throw new Error(`Proyecto seleccionado no encontrado: ${id}`);

  const copy = FEATURED_COPY[id];
  const cover = getProjectCover(entry.data.cover);
  if (!cover) throw new Error(`Portada no encontrada para ${id}`);

  const optimized = await getImage({
    src: cover,
    widths: [480, 720, 960, 1280],
    sizes: '(min-width: 1280px) 56vw, (min-width: 1024px) 54vw, 100vw',
    format: 'webp',
    quality: 80,
  });
  const client = entry.data.client ?? entry.data.title;
  const listLabel = projectListLabel(entry.data);
  const live = entry.data.links.live;

  return {
    id,
    number: copy.number,
    client,
    listLabel,
    category: copy.category,
    headline: copy.headline,
    summary: copy.summary,
    domain: domainFromLive(live),
    live,
    caseUrl: `/proyectos/${id}`,
    coverSrc: optimized.src,
    coverSrcSet: optimized.srcSet.attribute,
    coverWidth: optimized.attributes.width ?? 1280,
    coverHeight: optimized.attributes.height ?? 800,
    alt: copy.alt,
    theme: copy.theme,
    mediaPosition: copy.mediaPosition,
  };
}

const featured = await Promise.all(SELECTED_IDS.map(toFeaturedData));

const archiveSource = all
  .filter((entry) => !SELECTED_IDS.includes(entry.id as (typeof SELECTED_IDS)[number]))
  .sort(byOrderThenDate);

const archive: ArchiveProjectData[] = archiveSource.map((entry, index) => ({
  id: entry.id,
  number: String(index + SELECTED_IDS.length + 1).padStart(2, '0'),
  label: projectListLabel(entry.data),
  live: entry.data.links.live,
  caseUrl: isCaseStudyId(entry.id) ? `/proyectos/${entry.id}` : undefined,
}));
---

<section id="proyectos" class="projects-editorial" aria-labelledby="projects-heading">
  <div class="projects-editorial__intro container-page">
    <div class="projects-editorial__intro-grid">
      <div>
        <p class="projects-editorial__eyebrow">PROYECTOS SELECCIONADOS</p>
        <h2 id="projects-heading" class="projects-editorial__title">
          Casos reales,
          <span>no capturas vacías.</span>
        </h2>
      </div>

      <div class="projects-editorial__intro-copy">
        <p class="projects-editorial__lead">
          Cada proyecto partió de un problema concreto del negocio. El diseño y el desarrollo
          responden a eso.
        </p>
        <p class="projects-editorial__count">04 casos seleccionados</p>
      </div>
    </div>
  </div>

  <FeaturedProjectsList featured={featured} archive={archive} />
</section>
