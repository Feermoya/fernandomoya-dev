---
import HeroCanvas from '@/components/react/HeroCanvas';
import HeroMotion from '@/components/react/HeroMotion';
import { site } from '@/data/site';
---

<section
  id="inicio"
  class="hero-root hero-immersive hero-root--tight hero-root--light-page relative flex min-h-[calc(100svh-4.5rem)] flex-col overflow-hidden border-b border-white/[0.08] pb-8 pt-12 sm:min-h-[calc(100svh-4rem)] sm:pb-14 sm:pt-16 lg:pb-16 lg:pt-14"
  aria-labelledby="hero-heading"
>
  <HeroCanvas client:load />

  <div class="container-page relative z-10 flex min-h-0 w-full flex-1 flex-col justify-center">
    <div class="hero-text-scrim hero-text-scrim--center" aria-hidden="true"></div>
    <div class="hero-content-wrap hero-content-wrap--center">
      <HeroMotion
        client:load
        staticHeadline={`Una web clara
vende mejor.`}
        lead="Diseño webs claras para negocios que necesitan mostrar mejor lo que hacen."
        pillA="Webs nuevas para negocios reales"
        ctaPrimary="Quiero mi web"
        ctaSecondary="Ver proyectos"
        ctaPrimaryHref={site.social?.whatsapp || '/'}
        ctaSecondaryHref="#proyectos"
      />
    </div>
  </div>
</section>
