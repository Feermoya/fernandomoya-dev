---
import '@/styles/hero.css';
import { getImage } from 'astro:assets';
import HeroShowcase from '@/components/react/HeroShowcase';
import type { HeroProject } from '@/components/react/HeroShowcase';

import hemaCover from '@/assets/projects/hema.webp';
import giacomelliCover from '@/assets/projects/giacomelli.webp';
import poletinoCover from '@/assets/projects/poletino.webp';

const hemaImage = await getImage({ src: hemaCover, width: 1400, format: 'webp' });
const giacomelliImage = await getImage({ src: giacomelliCover, width: 1200, format: 'webp' });
const poletinoImage = await getImage({ src: poletinoCover, width: 1200, format: 'webp' });

const projects: HeroProject[] = [
  {
    name: 'HEMA',
    domain: 'hema.com.ar',
    imageSrc: hemaImage.src,
    imageWidth: hemaImage.attributes.width ?? 1400,
    imageHeight: hemaImage.attributes.height ?? 875,
    alt: 'Captura del sitio web de HEMA, laboratorio de diagnóstico genético',
    priority: true,
    slotClass: 'hero-editorial__window-slot--hema',
    depth: 0,
  },
  {
    name: 'Giacomelli Seguros',
    domain: 'giacomelliseguros.com',
    imageSrc: giacomelliImage.src,
    imageWidth: giacomelliImage.attributes.width ?? 1200,
    imageHeight: giacomelliImage.attributes.height ?? 750,
    alt: 'Captura del sitio web de Giacomelli Seguros, productor de seguros en Mendoza',
    slotClass: 'hero-editorial__window-slot--giacomelli',
    depth: 2,
  },
  {
    name: 'Poletino Servicios',
    domain: 'poletinosg.com.ar',
    imageSrc: poletinoImage.src,
    imageWidth: poletinoImage.attributes.width ?? 1200,
    imageHeight: poletinoImage.attributes.height ?? 750,
    alt: 'Captura del sitio web de Poletino Servicios, alquiler de hidrogrúas y transporte',
    slotClass: 'hero-editorial__window-slot--poletino',
    depth: 1,
  },
];
---

<HeroShowcase client:load projects={projects} />
