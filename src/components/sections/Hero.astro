---
import '@/styles/hero.css';
import { getImage } from 'astro:assets';
import HeroShowcase from '@/components/react/HeroShowcase';
import type { HeroProject } from '@/components/react/HeroShowcase';

import hemaCover from '@/assets/case-studies/hema.webp';
import giacomelliCover from '@/assets/projects/giacomelli.webp';
import poletinoCover from '@/assets/projects/poletino.webp';

const heroSizes = '(min-width: 1280px) 35rem, (min-width: 1024px) 42vw, 88vw';

const hemaImage = await getImage({
  src: hemaCover,
  widths: [400, 640, 800],
  sizes: heroSizes,
  format: 'webp',
});
const giacomelliImage = await getImage({
  src: giacomelliCover,
  widths: [400, 640, 800],
  sizes: heroSizes,
  format: 'webp',
});
const poletinoImage = await getImage({
  src: poletinoCover,
  widths: [400, 640, 800],
  sizes: heroSizes,
  format: 'webp',
});

const projects: HeroProject[] = [
  {
    name: 'HEMA',
    domain: 'hema.com.ar',
    imageSrc: hemaImage.src,
    imageSrcSet: hemaImage.srcSet.attribute,
    imageWidth: hemaImage.attributes.width ?? 800,
    imageHeight: hemaImage.attributes.height ?? 500,
    alt: 'Captura del sitio web de HEMA, laboratorio de diagnóstico genético',
    priority: true,
    slotClass: 'hero-editorial__window-slot--hema',
    depth: 0,
  },
  {
    name: 'Giacomelli',
    domain: 'giacomelliseguros.com',
    imageSrc: giacomelliImage.src,
    imageSrcSet: giacomelliImage.srcSet.attribute,
    imageWidth: giacomelliImage.attributes.width ?? 800,
    imageHeight: giacomelliImage.attributes.height ?? 500,
    alt: 'Captura del sitio web de Giacomelli Seguros, productor de seguros en Mendoza',
    slotClass: 'hero-editorial__window-slot--giacomelli',
    depth: 2,
  },
  {
    name: 'Poletino',
    domain: 'poletinosg.com.ar',
    imageSrc: poletinoImage.src,
    imageSrcSet: poletinoImage.srcSet.attribute,
    imageWidth: poletinoImage.attributes.width ?? 800,
    imageHeight: poletinoImage.attributes.height ?? 500,
    alt: 'Captura del sitio web de Poletino Servicios, alquiler de hidrogrúas y transporte',
    slotClass: 'hero-editorial__window-slot--poletino',
    depth: 1,
  },
];
---

<HeroShowcase client:idle projects={projects} />
