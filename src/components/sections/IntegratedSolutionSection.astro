---
import { getImage } from 'astro:assets';
import tarjetasImg from '@/assets/tarjetas.png';
import calcosImg from '@/assets/calcos.png';
import qrImg from '@/assets/qr.png';
import detallesImg from '@/assets/detalles.png';

const items = [
  {
    title: 'Tarjetas',
    image: tarjetasImg,
    alt: 'Tarjetas personales diseñadas para clientes',
  },
  {
    title: 'Calcos',
    image: calcosImg,
    alt: 'Calcos y stickers personalizados para marcas',
  },
  {
    title: 'QR',
    image: qrImg,
    alt: 'Piezas con código QR para negocios',
  },
  {
    title: 'DETALLES EMPRESARIALES',
    image: detallesImg,
    alt: 'Detalles de marca aplicados en piezas impresas',
  },
] as const;

const cards = await Promise.all(
  items.map(async (item) => ({
    ...item,
    src: (await getImage({ src: item.image, width: 1000 })).src,
  })),
);
---

<section
  id="piezas-marca"
  class="home-section-light relative border-t border-slate-200/70 py-10 sm:py-14"
  aria-labelledby="brand-pieces-heading"
>
  <div class="container-page">
    <div class="brand-pieces__intro max-w-2xl">
      <p class="home-section-eyebrow">También diseño</p>
      <h2 id="brand-pieces-heading" class="home-section-title mt-3">
        Piezas que acompañan la web.
      </h2>
      <div class="home-section-accent-line" aria-hidden="true"></div>
      <p class="home-section-lead">
        Tarjetas, calcos, QR y detalles de marca.
      </p>
    </div>

    <div class="brand-pieces__grid mt-8 grid grid-cols-2 gap-3 sm:mt-10 sm:gap-4 lg:grid-cols-4">
      {
        cards.map((item) => (
          <figure class="brand-piece">
            <div class="brand-piece__frame" tabindex="0">
              <img
                src={item.src}
                alt={item.alt}
                width="1000"
                height="750"
                loading="lazy"
                decoding="async"
                class="brand-piece__image"
              />
            </div>
            <figcaption class="brand-piece__label">{item.title}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .brand-piece {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .brand-piece__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid rgb(226 232 240 / 0.9);
    background: #ffffff;
    cursor: pointer;
    box-shadow: 0 12px 32px rgb(15 23 42 / 0.06);
    transition:
      transform 0.28s ease,
      border-color 0.28s ease,
      box-shadow 0.28s ease;
  }

  @media (hover: hover) {
    .brand-piece:hover .brand-piece__frame,
    .brand-piece:focus-within .brand-piece__frame {
      transform: translateY(-4px);
      border-color: rgb(148 163 184 / 0.55);
      box-shadow: 0 20px 44px rgb(15 23 42 / 0.1);
    }

    .brand-piece:hover .brand-piece__image,
    .brand-piece:focus-within .brand-piece__image {
      transform: scale(1.03);
    }
  }

  .brand-piece__frame:focus {
    outline: none;
  }

  .brand-piece__frame:focus-visible {
    outline: 1px dashed rgb(45 91 227 / 0.45);
    outline-offset: 2px;
  }

  .brand-piece__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .brand-piece__label {
    margin: 0;
    padding: 0 0.15rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(71 85 105);
    transition: color 0.2s ease;
  }

  .brand-piece:hover .brand-piece__label,
  .brand-piece:focus-within .brand-piece__label {
    color: rgb(15 23 42);
  }

  @media (max-width: 639px) {
    .brand-pieces__grid {
      gap: 0.75rem;
    }

    .brand-piece__label {
      font-size: 0.6875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-piece__frame,
    .brand-piece__image,
    .brand-piece__label {
      transition: none;
    }

    .brand-piece:hover .brand-piece__frame,
    .brand-piece:focus-within .brand-piece__frame {
      transform: none;
    }

    .brand-piece:hover .brand-piece__image,
    .brand-piece:focus-within .brand-piece__image {
      transform: none;
    }
  }
</style>
