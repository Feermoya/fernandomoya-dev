---
import { getImage } from 'astro:assets';
import tarjetasImg from '@/assets/tarjetas.png';
import calcosImg from '@/assets/calcos.png';
import qrImg from '@/assets/qr.png';
import detallesImg from '@/assets/detalles.png';

const items = [
  {
    title: 'Tarjetas',
    image: tarjetasImg,
    alt: 'Tarjetas personales diseñadas para clientes',
  },
  {
    title: 'Calcos',
    image: calcosImg,
    alt: 'Calcos y stickers personalizados para marcas',
  },
  {
    title: 'QR',
    image: qrImg,
    alt: 'Piezas con código QR para negocios',
  },
  {
    title: 'DETALLES EMPRESARIALES',
    image: detallesImg,
    alt: 'Detalles de marca aplicados en piezas impresas',
  },
] as const;

const cards = await Promise.all(
  items.map(async (item) => ({
    ...item,
    src: (await getImage({ src: item.image, width: 1000 })).src,
  })),
);
---

<section
  id="piezas-marca"
  class="home-section-light relative border-t border-slate-200/60 py-8 sm:py-12"
  aria-labelledby="brand-pieces-heading"
>
  <div class="container-page">
    <div class="brand-pieces-shell">
      <div class="brand-pieces-header">
        <p class="home-section-eyebrow">También diseño</p>
        <h2 id="brand-pieces-heading" class="home-section-title mt-3">
          Piezas que acompañan la web.
        </h2>
        <div class="home-section-accent-line" aria-hidden="true"></div>
        <p class="home-section-lead">
          Tarjetas, calcos, QR y detalles de marca.
        </p>
      </div>

      <div class="brand-pieces__grid mt-6 sm:mt-7">
        {
          cards.map((item) => (
            <figure class="brand-piece">
              <div class="brand-piece__frame" tabindex="0">
                <img
                  src={item.src}
                  alt={item.alt}
                  width="1000"
                  height="750"
                  loading="lazy"
                  decoding="async"
                  class="brand-piece__image"
                />
              </div>
              <figcaption class="brand-piece__label">{item.title}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .brand-pieces-shell {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    background:
      radial-gradient(circle at 8% 10%, rgba(96, 165, 250, 0.22), transparent 30%),
      radial-gradient(circle at 92% 18%, rgba(167, 139, 250, 0.18), transparent 34%),
      linear-gradient(135deg, #07111f 0%, #0b1020 52%, #111827 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 28px 80px rgba(15, 23, 42, 0.18);
  }

  .brand-pieces-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.22;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 20%, black 25%, transparent 75%);
  }

  .brand-pieces-header {
    position: relative;
    z-index: 1;
    max-width: 42rem;
  }

  .brand-pieces__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .brand-pieces__grid {
      gap: 0.85rem;
    }
  }

  @media (min-width: 1024px) {
    .brand-pieces-shell {
      border-radius: 2rem;
    }

    .brand-pieces__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.85rem;
    }
  }

  .brand-piece {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .brand-piece__frame {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    max-height: 7.5rem;
    overflow: hidden;
    border-radius: 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: linear-gradient(160deg, rgba(248, 250, 252, 0.94), rgba(241, 245, 249, 0.88));
    padding: 0.4rem;
    cursor: pointer;
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
    transition:
      transform 0.28s ease,
      border-color 0.28s ease,
      box-shadow 0.28s ease;
  }

  @media (min-width: 640px) {
    .brand-piece__frame {
      max-height: 8.5rem;
      padding: 0.45rem;
      border-radius: 0.9rem;
    }
  }

  @media (min-width: 1024px) {
    .brand-piece__frame {
      aspect-ratio: 4 / 3;
      max-height: 9.25rem;
      padding: 0.5rem;
      border-radius: 1rem;
    }
  }

  @media (hover: hover) {
    .brand-piece:hover .brand-piece__frame,
    .brand-piece:focus-within .brand-piece__frame {
      transform: translateY(-5px);
      border-color: rgba(255, 255, 255, 0.22);
      box-shadow:
        0 24px 48px rgba(0, 0, 0, 0.28),
        0 0 0 1px rgba(96, 165, 250, 0.12),
        inset 0 1px 0 rgba(255, 255, 255, 0.12);
    }

    .brand-piece:hover .brand-piece__image,
    .brand-piece:focus-within .brand-piece__image {
      transform: scale(1.04);
    }

    .brand-piece:hover .brand-piece__label,
    .brand-piece:focus-within .brand-piece__label {
      color: rgba(255, 255, 255, 0.95);
    }
  }

  .brand-piece__frame:focus {
    outline: none;
  }

  .brand-piece__frame:focus-visible {
    outline: 1px dashed rgba(96, 165, 250, 0.55);
    outline-offset: 2px;
  }

  .brand-piece__image {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 100%;
    border-radius: 0.5rem;
    object-fit: contain;
    object-position: center;
    transition: transform 0.35s ease;
  }

  .brand-piece__label {
    margin: 0;
    padding: 0 0.1rem;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
    transition: color 0.2s ease;
  }

  @media (min-width: 640px) {
    .brand-piece__label {
      font-size: 0.6875rem;
    }
  }

  @media (min-width: 1024px) {
    .brand-piece__label {
      font-size: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-piece__frame,
    .brand-piece__image,
    .brand-piece__label {
      transition: none;
    }

    .brand-piece:hover .brand-piece__frame,
    .brand-piece:focus-within .brand-piece__frame {
      transform: none;
    }

    .brand-piece:hover .brand-piece__image,
    .brand-piece:focus-within .brand-piece__image {
      transform: none;
    }
  }
</style>
