---
import '@/styles/process.css';

const steps = [
  {
    number: '01',
    label: 'ENTENDER',
    title: 'Entender el negocio.',
    body: 'Definimos qué necesita resolver la web, a quién tiene que hablarle y qué información importa primero.',
  },
  {
    number: '02',
    label: 'ORDENAR',
    title: 'Ordenar el contenido.',
    body: 'Organizo la información para que cada sección tenga una función y el recorrido sea fácil de entender.',
  },
  {
    number: '03',
    label: 'DISEÑAR',
    title: 'Crear una dirección propia.',
    body: 'Diseño una identidad visual coherente con la marca, el rubro y el tipo de cliente que necesita atraer.',
  },
  {
    number: '04',
    label: 'PUBLICAR',
    title: 'Desarrollar y publicar.',
    body: 'Construyo la web, optimizo su funcionamiento y la dejo preparada para recibir visitas y consultas.',
  },
] as const;
---

<section id="proceso" class="process-section" aria-labelledby="process-heading">
  <div class="container-page process-section__grid">
    <div class="process-section__intro">
      <p class="process-section__eyebrow">CÓMO TRABAJO</p>
      <h2 id="process-heading" class="process-section__title">
        Primero entiendo.
        <span>Después diseño.</span>
      </h2>
      <p class="process-section__lead">
        No tengo una plantilla que le aplico a todos los clientes. Cada etapa tiene una función
        clara antes de empezar a desarrollar.
      </p>
    </div>

    <div class="process-section__flow">
      <span class="process-section__divider" data-process-divider aria-hidden="true"></span>
      <ol class="process-section__steps">
        {
          steps.map((step) => (
            <li class="process-section__step" data-process-step>
              <span class="process-section__number" aria-hidden="true">
                {step.number}
              </span>
              <div>
                <p class="process-section__eyebrow">{step.label}</p>
                <h3 class="process-section__step-title">{step.title}</h3>
                <p class="process-section__step-body">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import '@/scripts/process-motion';
</script>
