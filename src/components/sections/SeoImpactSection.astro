---
import '@/styles/seo-impact.css';
import SeoPerformanceChart from '@/components/react/SeoPerformanceChart';
import {
  seoPerformanceCase,
  seoPerformanceSeries,
  seoPerformanceSummary,
} from '@/data/seo-performance';

function formatClicks(value: number): string {
  return new Intl.NumberFormat('es-AR').format(value);
}

function formatImpressions(value: number): string {
  const thousands = value / 1000;
  return `${thousands.toLocaleString('es-AR', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })} mil`;
}

function formatPosition(value: number): string {
  return value.toLocaleString('es-AR', {
    minimumFractionDigits: 1,
    maximumFractionDigits: 1,
  });
}

const visitsLabel = formatClicks(seoPerformanceSummary.clicks);
const appearancesLabel = formatImpressions(seoPerformanceSummary.impressions);
const positionLabel = formatPosition(seoPerformanceSummary.averagePosition);
---

<section id="resultados-seo" class="seo-impact" aria-labelledby="seo-impact-heading">
  <div class="container-page seo-impact__inner">
    <header class="seo-impact__header">
      <p class="seo-impact__eyebrow">RESULTADOS REALES</p>

      <div class="seo-impact__header-grid">
        <h2 id="seo-impact-heading" class="seo-impact__title">
          Tener una web no alcanza
          <span>si nadie la encuentra.</span>
        </h2>

        <div class="seo-impact__intro">
          <p class="seo-impact__lead">
            Trabajo la estructura, el contenido y el rendimiento para que tu proyecto aparezca
            cuando alguien busca ese servicio en Google.
          </p>
          <p class="seo-impact__case-id">{seoPerformanceCase.identification}</p>
        </div>
      </div>
    </header>

    <div class="seo-impact__panel">
      <dl class="seo-impact__metrics">
        <div class="seo-impact__metric seo-impact__metric--primary">
          <dt>Visitas desde Google</dt>
          <dd>
            <span class="seo-impact__metric-sr">Visitas desde Google: {visitsLabel}</span>
            <span
              class="seo-impact__metric-value"
              aria-hidden="true"
              data-seo-count="clicks"
              data-seo-value={seoPerformanceSummary.clicks}
            >
              {visitsLabel}
            </span>
            <p class="seo-impact__metric-hint" aria-hidden="true">
              Personas que llegaron al sitio desde una búsqueda.
            </p>
          </dd>
        </div>
        <div class="seo-impact__metric seo-impact__metric--primary">
          <dt>Apariciones en Google</dt>
          <dd>
            <span class="seo-impact__metric-sr">Apariciones en Google: {appearancesLabel}</span>
            <span
              class="seo-impact__metric-value"
              aria-hidden="true"
              data-seo-count="impressions"
              data-seo-value={seoPerformanceSummary.impressions}
            >
              {appearancesLabel}
            </span>
            <p class="seo-impact__metric-hint" aria-hidden="true">
              Veces que la web se mostró en resultados de búsqueda.
            </p>
          </dd>
        </div>
        <div class="seo-impact__metric">
          <dt>Posición promedio</dt>
          <dd>
            <span class="seo-impact__metric-sr">Posición promedio: {positionLabel}</span>
            <span
              class="seo-impact__metric-value"
              aria-hidden="true"
              data-seo-count="averagePosition"
              data-seo-value={seoPerformanceSummary.averagePosition}
            >
              {positionLabel}
            </span>
            <p class="seo-impact__metric-hint" aria-hidden="true">
              En promedio, apareció entre los primeros resultados.
            </p>
          </dd>
        </div>
        <div class="seo-impact__metric">
          <dt>Período analizado</dt>
          <dd>
            <span class="seo-impact__metric-sr">Período analizado: 90 días</span>
            <span class="seo-impact__metric-value" aria-hidden="true">90 días</span>
            <p class="seo-impact__metric-hint" aria-hidden="true">
              Resultados acumulados del caso presentado.
            </p>
          </dd>
        </div>
      </dl>

      <div class="seo-impact__chart-area">
        <div class="seo-impact__chart-copy">
          <p class="seo-impact__highlight">
            Más de 2.100 apariciones en Google generaron 178 visitas reales al sitio.
          </p>
          <p class="seo-impact__note">{seoPerformanceCase.note}</p>
        </div>

        <SeoPerformanceChart
          client:visible
          series={seoPerformanceSeries}
          summary={seoPerformanceSummary}
        />
      </div>
    </div>
  </div>
</section>
