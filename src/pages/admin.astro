---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { pageTitle } from '@/utils/seo';
import { Lock, Wallet, ChartNoAxesCombined, ChevronRight, ArrowLeft } from 'lucide-react';

const tools = [
  {
    href: '/panel',
    title: 'Panel de cobros',
    description: 'Clientes, cobros y pagos.',
    Icon: Wallet,
  },
  {
    href: '/foco-financiero',
    title: 'Foco Financiero',
    description: 'Control financiero e inversiones.',
    Icon: ChartNoAxesCombined,
  },
] as const;
---

<Layout
  title={pageTitle('Admin')}
  description="Selector de herramientas privadas."
  path="/admin"
  noindex={true}
>
  <div class="admin-page">
    <div class="admin-page__inner">
      <a href="/" class="admin-page__back">
        <ArrowLeft size={16} strokeWidth={2.25} aria-hidden="true" />
        Inicio
      </a>

      <header class="admin-page__header">
        <p class="admin-page__eyebrow">
          <Lock size={14} strokeWidth={2.25} aria-hidden="true" />
          Panel privado
        </p>
        <h1 class="admin-page__title">Herramientas</h1>
      </header>

      <ul class="admin-page__list">
        {
          tools.map(({ href, title, description, Icon }) => (
            <li>
              <article class="admin-tool">
                <div class="admin-tool__icon" aria-hidden="true">
                  <Icon size={20} strokeWidth={2.1} />
                </div>
                <div class="admin-tool__body">
                  <h2 class="admin-tool__title">{title}</h2>
                  <p class="admin-tool__desc">{description}</p>
                </div>
                <a href={href} class="admin-tool__cta">
                  Abrir
                  <ChevronRight size={16} strokeWidth={2.25} aria-hidden="true" />
                </a>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Layout>

<style>
  .admin-page {
    min-height: 70dvh;
    padding: clamp(1.25rem, 4vw, 2.5rem) 0 clamp(3rem, 8vw, 5rem);
  }

  .admin-page__inner {
    width: min(100% - 2rem, 28rem);
    margin-inline: auto;
  }

  .admin-page__back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--fm-text-secondary, #5c564c);
    text-decoration: none;
  }

  .admin-page__back:hover {
    color: var(--fm-text-primary, #1a1814);
  }

  .admin-page__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fm-text-tertiary, #8a8278);
  }

  .admin-page__title {
    margin: 0;
    font-family: var(--fm-font-display, 'Instrument Serif', Georgia, serif);
    font-size: clamp(2rem, 6vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--fm-text-primary, #1a1814);
  }

  .admin-page__list {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .admin-tool {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1rem 1rem 0.95rem;
    border: 1px solid var(--fm-border-light, rgba(26, 24, 20, 0.1));
    border-radius: 1rem;
    background: color-mix(in srgb, var(--fm-bg-elevated, #fff) 92%, transparent);
    box-shadow: 0 1px 2px rgba(26, 24, 20, 0.04);
  }

  .admin-tool__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--fm-text-primary, #1a1814) 6%, transparent);
    color: var(--fm-text-primary, #1a1814);
  }

  .admin-tool__body {
    min-width: 0;
  }

  .admin-tool__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--fm-text-primary, #1a1814);
  }

  .admin-tool__desc {
    margin: 0.2rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--fm-text-secondary, #5c564c);
  }

  .admin-tool__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    min-height: 2.5rem;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    text-decoration: none;
    color: #fff;
    background: var(--fm-text-primary, #1a1814);
  }

  .admin-tool__cta:hover {
    opacity: 0.9;
  }

  @media (max-width: 360px) {
    .admin-tool {
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
    }

    .admin-tool__cta {
      grid-column: 1 / -1;
      justify-content: center;
    }
  }
</style>
