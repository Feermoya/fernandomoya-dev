---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import FinanceGameApp from '@/components/finance/FinanceGameApp';
import { pageTitle } from '@/utils/seo';
import { FINANCE_APP_DATA_VERSION } from '@/lib/finance/appVersion';
---

<Layout
  title={pageTitle('Foco financiero')}
  description="Tu progreso e inversión mensual en una sola pantalla."
  path="/foco-financiero"
  noindex={true}
  appShell={true}
>
  <script is:inline define:vars={{ financeAppVersion: FINANCE_APP_DATA_VERSION }}>
    (function () {
      try {
        var key = 'fm-finance-app-version';
        var bookId = 'fernando-foco-financiero-main';
        var syncKey = 'fm-finance-sync-id';
        var legacyKey = 'fm-finance-legacy-sync-id';
        var prevSync = localStorage.getItem(syncKey);
        if (prevSync && prevSync !== bookId && !localStorage.getItem(legacyKey)) {
          localStorage.setItem(legacyKey, prevSync);
        }
        if (localStorage.getItem(key) !== financeAppVersion) {
          localStorage.setItem(key, financeAppVersion);
        }
        localStorage.setItem(syncKey, bookId);
      } catch (e) {
        /* ignore */
      }
    })();
  </script>
  <FinanceGameApp client:only="react" />
</Layout>
