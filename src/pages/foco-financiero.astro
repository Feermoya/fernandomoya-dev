---
import Layout from '@/layouts/Layout.astro';
import FinanceGameApp from '@/components/finance/FinanceGameApp';
import { pageTitle } from '@/utils/seo';
---

<Layout
  title={pageTitle('Foco financiero')}
  description="Mini app personal de progreso e inversión mensual. Datos solo en tu navegador."
  path="/foco-financiero"
  noindex={true}
  skipSplash={true}
>
  <section class="relative overflow-hidden border-b border-white/[0.08] bg-[#06111f]">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute left-[-10%] top-[-40%] h-72 w-72 rounded-full bg-emerald-500/20 blur-3xl"></div>
      <div class="absolute right-[-8%] top-[-30%] h-80 w-80 rounded-full bg-violet-500/20 blur-3xl"></div>
      <div class="absolute bottom-[-35%] left-[35%] h-72 w-72 rounded-full bg-cyan-500/10 blur-3xl"></div>
      <div
        class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.035)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.035)_1px,transparent_1px)] bg-[size:32px_32px] opacity-40"
      >
      </div>
    </div>

    <div class="container-page relative z-[1] py-7 sm:py-10">
      <div class="max-w-5xl">
        <div class="flex flex-wrap items-center gap-3">
          <span
            class="rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3 py-1 text-[10px] font-black uppercase tracking-[0.22em] text-emerald-200"
          >
            App personal
          </span>
          <span
            class="rounded-full border border-violet-400/30 bg-violet-400/10 px-3 py-1 text-[10px] font-black uppercase tracking-[0.22em] text-violet-200"
          >
            Modo juego
          </span>
        </div>

        <h1 class="mt-5 max-w-3xl text-3xl font-black tracking-tight text-white sm:text-5xl">
          Convertí inversión mensual en progreso visible.
        </h1>

        <p class="mt-4 max-w-2xl text-base font-semibold leading-relaxed text-slate-300 sm:text-lg">
          Una pantalla para ver tu nivel, cargar inversión y saber qué falta para subir.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="#inversion"
            class="inline-flex min-h-[46px] items-center justify-center rounded-2xl bg-gradient-to-r from-emerald-500 to-cyan-500 px-5 py-3 text-sm font-black text-slate-950 shadow-[0_18px_45px_-18px_rgba(16,185,129,0.9)] transition hover:brightness-110 active:scale-[0.99]"
          >
            Cargar inversión
          </a>

          <a
            href="#dashboard-financiero"
            class="inline-flex min-h-[46px] items-center justify-center rounded-2xl border border-white/12 bg-white/7 px-5 py-3 text-sm font-black text-white backdrop-blur-md transition hover:bg-white/10"
          >
            Ver nivel actual
          </a>
        </div>
      </div>
    </div>
  </section>

  <details class="container-page border-b border-white/[0.04] py-2 text-sm text-slate-500">
    <summary class="cursor-pointer text-sm font-medium text-slate-500 hover:text-slate-400">
      Por qué existe esto
    </summary>
    <div class="mt-2 max-w-2xl space-y-2 rounded-lg border border-white/[0.06] bg-slate-950/40 p-3 text-sm text-slate-400">
      <p>
        Herramienta personal: no está en el menú principal. Con variables de nube en el hosting, los datos se guardan
        solos entre dispositivos; si no, quedan en el navegador y podés usar Respaldo (JSON / archivo).
      </p>
      <p class="text-xs text-slate-500">
        Reglas: registrar cada inversión cuando la hacés, mirar el nivel del mes y la ruta.
      </p>
    </div>
  </details>

  <FinanceGameApp client:load />
</Layout>
