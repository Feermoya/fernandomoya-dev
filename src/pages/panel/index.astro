---
export const prerender = false;

import PanelLayout from '@/layouts/PanelLayout.astro';
import { SummaryCard } from '@/components/panel/SummaryCard';
import { formatCurrencyAmount } from '@/components/panel/CurrencyAmount';
import { ChargeListItem } from '@/components/panel/ChargeListItem';
import { CollectedMonthChart } from '@/components/panel/CollectedMonthChart';
import { RegisterCobroLauncher } from '@/components/panel/RegisterCobroLauncher';
import { PANEL_PATHS } from '@/lib/panel/auth';
import { requirePanelDataAccess, panelLoginRedirectUrl } from '@/lib/panel/session';
import { loadDashboard } from '@/lib/panel/repositories/dashboard';
import { formatDueShortLabel } from '@/lib/panel/view-types';

const access = requirePanelDataAccess(Astro.cookies);
if (!access.ok) {
  if (access.reason === 'unauthenticated') {
    return Astro.redirect(panelLoginRedirectUrl());
  }
}

const result =
  access.ok ? await loadDashboard(access.supabase) : { data: null, error: access.message };
const dash = result.data;
const loadError = result.error;

const collectedArs = dash?.collectedThisMonthArs ?? 0;
const overdueCount = dash?.overdueCount ?? 0;
const upcomingCount = dash?.upcomingCount ?? 0;
const upcomingPreview = dash?.upcomingExpectations.slice(0, 6) ?? [];
---

<PanelLayout title="Inicio" path={PANEL_PATHS.root}>
  <header class="panel-header">
    <div class="min-w-0">
      <p class="panel-header__eyebrow">Panel de cobros</p>
      <h1 class="panel-header__title">Inicio</h1>
    </div>
    {
      dash ? (
        <RegisterCobroLauncher client:load unpaidCharges={dash.unpaidCharges} />
      ) : null
    }
  </header>

  {
    loadError ? (
      <div class="panel-alert" role="alert">
        No se pudieron cargar los datos. Probá de nuevo más tarde.
      </div>
    ) : null
  }

  {
    !dash && !loadError ? (
      <div class="panel-skeleton-stack" aria-busy="true" aria-label="Cargando panel">
        <div class="panel-skeleton-metrics">
          <div class="panel-skeleton panel-skeleton--card" />
          <div class="panel-skeleton panel-skeleton--card" />
          <div class="panel-skeleton panel-skeleton--card" />
          <div class="panel-skeleton panel-skeleton--card" />
        </div>
        <div class="panel-skeleton panel-skeleton--strip" />
        <div class="panel-skeleton panel-skeleton--chart" />
      </div>
    ) : null
  }

  {
    dash ? (
      <div class="panel-dash">
        <section class="panel-metrics" aria-label="Resumen">
          <SummaryCard
            label="Cobrado este mes"
            value={formatCurrencyAmount(collectedArs, 'ARS')}
            hint={collectedArs > 0 ? 'Según fecha de pago' : 'Sin cobros registrados este mes'}
            tone={collectedArs > 0 ? 'success' : 'default'}
            icon="money"
          />
          <SummaryCard
            label="Vencidos"
            value={`${overdueCount}`}
            hint={overdueCount > 0 ? 'Requieren atención' : 'Todo al día'}
            tone={overdueCount > 0 ? 'danger' : 'default'}
            icon="alert"
          />
          <SummaryCard
            label="Próximos"
            value={`${upcomingCount}`}
            hint={
              upcomingCount > 0
                ? 'Próximos vencimientos a controlar'
                : 'No hay cobros próximos'
            }
            tone={upcomingCount > 0 ? 'warning' : 'default'}
            icon="calendar"
          />
          <SummaryCard
            label="Clientes activos"
            value={`${dash.activeClients}`}
            hint={
              dash.activeServices === 1
                ? '1 servicio activo'
                : `${dash.activeServices} servicios activos`
            }
            icon="users"
            tone="default"
          />
        </section>

        <div class="panel-dash-mid">
          <div class="panel-dash-mid__side">
            <p class="panel-mrr-strip" aria-label="MRR actual">
              <span>
                MRR USD: <strong>{formatCurrencyAmount(dash.mrrUsd, 'USD')}</strong>
              </span>
              <span class="panel-mrr-strip__sep" aria-hidden="true">·</span>
              <span>
                MRR ARS: <strong>{formatCurrencyAmount(dash.mrrArs, 'ARS')}</strong>
              </span>
            </p>

            <section class="panel-total-card" aria-label="Total cobrado histórico">
              <div class="panel-total-card__body">
                <p class="panel-total-card__label">Total cobrado</p>
                <p class="panel-total-card__value">
                  {formatCurrencyAmount(dash.totalCollectedArs, 'ARS')}
                </p>
                <p class="panel-total-card__hint">Desde el inicio</p>
                {
                  dash.totalCollectedUsd > 0 ? (
                    <p class="panel-total-card__usd">
                      + {formatCurrencyAmount(dash.totalCollectedUsd, 'USD')} cobrados en USD
                    </p>
                  ) : null
                }
              </div>
            </section>
          </div>

          <section class="panel-dash-mid__chart" aria-label="Cobrado por mes">
            <CollectedMonthChart client:load series={dash.collectedSeries} />
          </section>
        </div>

        <div class="panel-dash-lower">
          <section class="panel-section" aria-label="Próximos cobros">
            <div class="panel-section__head">
              <h2 class="panel-section__title">Próximos cobros</h2>
              <a href="/panel/cobros" class="panel-section__link">Ver todos</a>
            </div>
            {
              upcomingPreview.length === 0 ? (
                <p class="panel-empty">No hay cobros próximos.</p>
              ) : (
                <ul class="panel-upcoming-grid">
                  {upcomingPreview.map((item) => (
                    <li class="panel-upcoming-mini">
                      <p class="panel-upcoming-mini__name">{item.clientName}</p>
                      <p class="panel-upcoming-mini__amount">
                        {formatCurrencyAmount(item.referenceAmount, item.referenceCurrency)}
                      </p>
                      <p class="panel-upcoming-mini__date">{formatDueShortLabel(item.dueDate)}</p>
                    </li>
                  ))}
                </ul>
              )
            }
          </section>

          {
            dash.attentionCharges.length > 0 ? (
              <section class="panel-section" aria-label="Requieren atención">
                <div class="panel-section__head">
                  <h2 class="panel-section__title">Requieren atención</h2>
                </div>
                <ul class="panel-list panel-attention-grid">
                  {dash.attentionCharges.map((charge) => (
                    <li>
                      <ChargeListItem charge={charge} />
                    </li>
                  ))}
                </ul>
              </section>
            ) : null
          }
        </div>
      </div>
    ) : null
  }

  <p class="text-center">
    <a href={PANEL_PATHS.signout} class="panel-signout">Cerrar sesión</a>
  </p>
</PanelLayout>
