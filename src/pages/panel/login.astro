---
export const prerender = false;

import PanelLayout from '@/layouts/PanelLayout.astro';
import { site } from '@/data/site';
import { isPanelAuthConfigured, PANEL_PATHS, safePostLoginPath } from '@/lib/panel/auth';

const configured = isPanelAuthConfigured();
const error = Astro.url.searchParams.get('error');
const next = safePostLoginPath(Astro.url.searchParams.get('next'));

const errorMessage =
  error === 'config'
    ? 'El acceso privado no está disponible por ahora.'
    : error === 'pin'
      ? 'Clave incorrecta. Probá de nuevo.'
      : null;

const nextHint =
  next === '/foco-financiero'
    ? 'Vas a entrar a Foco financiero.'
    : next === '/admin'
      ? 'Vas a entrar a Admin.'
      : null;
---

<PanelLayout title="Ingresar" path={PANEL_PATHS.login} description="Acceso privado." showNav={false}>
  <p class="panel-brand">{site.name}</p>
  <h1 class="panel-title">Acceso privado</h1>
  <p class="panel-copy">
    Ingresá la clave de acceso. Solo vos tenés que conocerla.
    {nextHint ? ` ${nextHint}` : ''}
  </p>

  <div class="panel-card">
    {
      !configured ? (
        <div class="panel-alert" role="alert">
          El acceso privado no está configurado. Contactá al administrador del sitio.
        </div>
      ) : null
    }
    {errorMessage ? <div class="panel-alert" role="alert">{errorMessage}</div> : null}

    <form method="POST" action={PANEL_PATHS.loginAction} class="panel-stack">
      {next ? <input type="hidden" name="next" value={next} /> : null}
      <label class="panel-meta" for="pin" style="margin-top:0">
        Clave
      </label>
      <input
        id="pin"
        name="pin"
        type="password"
        autocomplete="current-password"
        required
        class="panel-input"
        placeholder="••••••••"
        disabled={!configured}
      />
      <button type="submit" class="panel-btn panel-btn--primary" disabled={!configured}>
        Entrar
      </button>
    </form>
  </div>
</PanelLayout>

<style>
  .panel-input {
    width: 100%;
    min-height: 2.875rem;
    padding: 0.75rem 0.875rem;
    border-radius: 0.65rem;
    border: 1px solid var(--panel-border);
    background: var(--panel-surface);
    color: var(--panel-text);
    font: inherit;
    font-size: 1rem;
  }

  .panel-input:focus {
    outline: 2px solid var(--panel-text);
    outline-offset: 2px;
  }
</style>
