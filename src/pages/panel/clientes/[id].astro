---
export const prerender = false;

import PanelLayout from '@/layouts/PanelLayout.astro';
import PanelHeader from '@/components/panel/PanelHeader.astro';
import { formatCurrencyAmount } from '@/components/panel/CurrencyAmount';
import { StatusBadge } from '@/components/panel/StatusBadge';
import { ClientBillingBadge } from '@/components/panel/ClientBillingBadge';
import { ClientEditSheet } from '@/components/panel/ClientEditSheet';
import { ServiceCreateLauncher } from '@/components/panel/ServiceCreateLauncher';
import { ServiceTariffSheet } from '@/components/panel/ServiceTariffSheet';
import { ServiceDeactivateButton } from '@/components/panel/ServiceDeactivateButton';
import { ClientDetailActions } from '@/components/panel/ClientDetailActions';
import { AddWorkLauncher } from '@/components/panel/AddWorkLauncher';
import { RegisterCobroLauncher } from '@/components/panel/RegisterCobroLauncher';
import { requirePanelDataAccess, panelLoginRedirectUrl } from '@/lib/panel/session';
import { getClientDetail } from '@/lib/panel/repositories/clients';
import { resolvePanelBackLink } from '@/lib/panel/navigation';
import {
  formatDueLabel,
  formatDueShortLabel,
  formatPeriodLabel,
  todayIsoDate,
} from '@/lib/panel/view-types';
import { resolveClientBillingStatus } from '@/lib/panel/clients/listStatus';

const { id } = Astro.params;

const access = requirePanelDataAccess(Astro.cookies);
if (!access.ok) {
  if (access.reason === 'unauthenticated') {
    return Astro.redirect(panelLoginRedirectUrl());
  }
}

if (!id) {
  return Astro.redirect('/panel/clientes');
}

const result = access.ok
  ? await getClientDetail(access.supabase, id)
  : { data: null, error: access.message };

if (!result.error && !result.data) {
  return Astro.redirect('/panel/clientes');
}

const detail = result.data;
const loadError = result.error;
const today = todayIsoDate();
const activeServices = detail
  ? detail.services.filter((s) => s.active && (!s.ended_at || s.ended_at >= today))
  : [];
const unpaidCharges = detail
  ? detail.charges.filter(
      (c) => c.status === 'upcoming' || c.status === 'due_today' || c.status === 'overdue',
    )
  : [];
const nextCharge = unpaidCharges.slice().sort((a, b) => a.dueDate.localeCompare(b.dueDate))[0];
const billingStatus = detail
  ? resolveClientBillingStatus({
      active: detail.client.active,
      unpaidStatuses: unpaidCharges.map((c) => c.status),
    })
  : 'inactive';

const paidHistory = detail
  ? detail.charges
      .filter((c) => c.status === 'paid')
      .sort((a, b) => (b.paidAt ?? b.dueDate).localeCompare(a.paidAt ?? a.dueDate))
  : [];

const autoOpenService = Astro.url.searchParams.get('nuevoServicio') === '1';
const ok = Astro.url.searchParams.get('ok');
const back = resolvePanelBackLink(`/panel/clientes/${id}`);

const startParts = detail?.client.start_date?.split('-') ?? [];
const startLabel =
  startParts.length >= 2
    ? `${['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'][Number(startParts[1]) - 1] ?? startParts[1]} ${startParts[0]}`
    : '—';
---

<PanelLayout title={detail?.client.name ?? 'Cliente'} path={`/panel/clientes/${id}`}>
  <PanelHeader
    title={detail?.client.name ?? 'Cliente'}
    subtitle={undefined}
    backHref={back?.href}
    backLabel={back?.label ?? 'Clientes'}
  >
    {
      detail ? (
        <div slot="action" class="panel-header__actions">
          <ClientBillingBadge status={billingStatus} />
        </div>
      ) : null
    }
  </PanelHeader>

  {
    ok === 'servicio' || ok === 'trabajo' ? (
      <p class="panel-toast" role="status">
        {ok === 'trabajo' ? 'Trabajo creado' : 'Servicio creado'}
      </p>
    ) : null
  }

  {
    loadError || !detail ? (
      <div class="panel-alert" role="alert">
        No se pudo cargar el cliente. Probá de nuevo más tarde.
      </div>
    ) : (
      <>
        <section class="panel-client-facts" aria-label="Resumen del cliente">
          <div class="panel-client-facts__cell">
            <p class="panel-client-facts__label">Estado</p>
            <p class="panel-client-facts__value">
              {
                billingStatus === 'overdue'
                  ? 'Vencido'
                  : billingStatus === 'due_today'
                    ? 'Vence hoy'
                    : billingStatus === 'upcoming'
                      ? 'Próximo'
                      : billingStatus === 'inactive'
                        ? 'Inactivo'
                        : 'Al día'
              }
            </p>
          </div>
          <div class="panel-client-facts__cell">
            <p class="panel-client-facts__label">Próximo vencimiento</p>
            <p class="panel-client-facts__value">
              {nextCharge ? formatDueShortLabel(nextCharge.dueDate) : '—'}
            </p>
          </div>
          <div class="panel-client-facts__cell">
            <p class="panel-client-facts__label">Servicios</p>
            <p class="panel-client-facts__value">{activeServices.length}</p>
          </div>
          <div class="panel-client-facts__cell">
            <p class="panel-client-facts__label">Cliente desde</p>
            <p class="panel-client-facts__value">{startLabel}</p>
          </div>
        </section>

        <div class="panel-client-actions">
          {
            unpaidCharges.length > 0 ? (
              <RegisterCobroLauncher client:load unpaidCharges={unpaidCharges} />
            ) : (
              <span class="panel-action-btn panel-action-btn--disabled" aria-disabled="true">
                Sin cobros pendientes
              </span>
            )
          }
          <ServiceCreateLauncher client:load clientId={detail.client.id} autoOpen={autoOpenService} />
          <AddWorkLauncher client:load clientId={detail.client.id} />
          <ClientEditSheet client:load client={detail.client} />
        </div>

        {
          unpaidCharges.length > 0 ? (
            <section class="panel-section" aria-label="Cobros pendientes">
              <div class="panel-section__head">
                <h2 class="panel-section__title">Pendientes</h2>
              </div>
              <ClientDetailActions client:load unpaidCharges={unpaidCharges} />
            </section>
          ) : null
        }

        <section class="panel-section" aria-label="Servicios">
          <div class="panel-section__head">
            <h2 class="panel-section__title">Servicios</h2>
          </div>
          {
            detail.services.length === 0 ? (
              <p class="panel-empty">Sin servicios.</p>
            ) : (
              <ul class="panel-service-list">
                {detail.services.map((service) => (
                  <li class="panel-service-row">
                    <div class="panel-service-row__main">
                      <div class="panel-service-row__top">
                        <p class="panel-service-row__name">{service.name}</p>
                        <span class="panel-badge panel-badge--muted">
                          {service.active ? 'Activo' : 'Inactivo'}
                        </span>
                      </div>
                      <p class="panel-service-row__tariff">
                        {formatCurrencyAmount(service.reference_amount, service.reference_currency)}
                        {service.billing_type === 'recurring' ? ' / mes' : ''}
                      </p>
                      <p class="panel-service-row__meta">
                        {service.billing_type === 'recurring'
                          ? `${service.billing_mode === 'previous_month' ? 'Mes vencido' : 'Mes actual'} · Día ${service.due_day}`
                          : 'Trabajo puntual'}
                      </p>
                    </div>
                    {
                      service.active ? (
                        <div class="panel-service-row__actions">
                          <ServiceTariffSheet
                            client:load
                            serviceId={service.id}
                            serviceName={service.name}
                            currentAmount={service.reference_amount}
                            currency={service.reference_currency}
                          />
                          <ServiceDeactivateButton client:load service={service} />
                        </div>
                      ) : null
                    }
                  </li>
                ))}
              </ul>
            )
          }
        </section>

        <section class="panel-section" aria-label="Historial de pagos">
          <div class="panel-section__head">
            <h2 class="panel-section__title">Historial de pagos</h2>
          </div>
          {
            paidHistory.length === 0 ? (
              <p class="panel-empty">Todavía no hay pagos registrados.</p>
            ) : (
              <ul class="panel-pay-timeline">
                {paidHistory.map((charge) => (
                  <li class="panel-pay-timeline__item">
                    <div class="panel-pay-timeline__dot" aria-hidden />
                    <div class="panel-pay-timeline__body">
                      <div class="panel-pay-timeline__top">
                        <p class="panel-pay-timeline__period">
                          {formatPeriodLabel(charge.period)}
                        </p>
                        <StatusBadge status={charge.status} />
                      </div>
                      <p class="panel-pay-timeline__amount">
                        {charge.payment
                          ? formatCurrencyAmount(
                              charge.payment.amount_received,
                              charge.payment.currency_received,
                            )
                          : formatCurrencyAmount(charge.referenceAmount, charge.referenceCurrency)}
                      </p>
                      <p class="panel-pay-timeline__meta">
                        {charge.serviceName}
                        {charge.paidAt ? ` · ${formatDueLabel(charge.paidAt)}` : ''}
                      </p>
                    </div>
                  </li>
                ))}
              </ul>
            )
          }
        </section>
      </>
    )
  }
</PanelLayout>
