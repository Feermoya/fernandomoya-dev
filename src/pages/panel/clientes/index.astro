---
export const prerender = false;

import PanelLayout from '@/layouts/PanelLayout.astro';
import { ClientListItem } from '@/components/panel/ClientListItem';
import { ClientCreateLauncher } from '@/components/panel/ClientCreateLauncher';
import { requirePanelDataAccess, panelLoginRedirectUrl } from '@/lib/panel/session';
import { listClientsWithActiveServices } from '@/lib/panel/repositories/clients';

const access = requirePanelDataAccess(Astro.cookies);
if (!access.ok) {
  if (access.reason === 'unauthenticated') {
    return Astro.redirect(panelLoginRedirectUrl());
  }
}

const result = access.ok
  ? await listClientsWithActiveServices(access.supabase)
  : { data: [], error: access.message };

const clients = result.data;
const loadError = result.error;
const ok = Astro.url.searchParams.get('ok');
---

<PanelLayout title="Clientes" path="/panel/clientes">
  <header class="panel-header">
    <div class="min-w-0">
      <p class="panel-header__eyebrow">Panel de cobros</p>
      <h1 class="panel-header__title">Clientes</h1>
      <p class="panel-header__subtitle">
        {loadError ? 'Error al cargar' : `${clients.length} en total`}
      </p>
    </div>
    <ClientCreateLauncher client:load />
  </header>

  {
    ok === 'cliente' ? (
      <p class="panel-toast" role="status">
        Cliente creado
      </p>
    ) : null
  }

  {
    loadError ? (
      <div class="panel-alert" role="alert">
        No se pudieron cargar los clientes. Probá de nuevo más tarde.
      </div>
    ) : clients.length === 0 ? (
      <p class="panel-empty">Aún no hay clientes.</p>
    ) : (
      <ul class="panel-list">
        {clients.map((client) => (
          <li>
            <ClientListItem client={client} href={`/panel/clientes/${client.id}`} />
          </li>
        ))}
      </ul>
    )
  }
</PanelLayout>
