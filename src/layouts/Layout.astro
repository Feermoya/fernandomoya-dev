---
import '@/styles/global.css';
import AmbientBackdrop from '@/components/layout/AmbientBackdrop.astro';
import Header from '@/components/layout/Header.astro';
import CaseStudyHeader from '@/components/layout/CaseStudyHeader.astro';
import Footer from '@/components/layout/Footer.astro';
import { site } from '@/data/site';
import { absoluteUrl } from '@/utils/seo';

type ShellApp = 'finance' | 'tournaments';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImagePath?: string;
  noindex?: boolean;
  /**
   * Shell de app: sin nav/footer del sitio.
   * Compat: `true` = Foco financiero (comportamiento histórico).
   */
  appShell?: boolean;
  /**
   * Identidad del shell cuando `appShell` es true.
   * Default `finance` para no alterar Foco financiero.
   */
  shellApp?: ShellApp;
  /** Caso de estudio: header con volver al trabajo. */
  caseStudyHeader?: boolean;
}

const {
  title,
  description,
  path = '/',
  ogImagePath,
  noindex = false,
  appShell = false,
  shellApp = 'finance',
  caseStudyHeader = false,
} = Astro.props;
const canonical = absoluteUrl(path);
const ogImage = ogImagePath ? absoluteUrl(ogImagePath) : undefined;

const activeShell: ShellApp | null = appShell ? shellApp : null;
const isFinanceShell = activeShell === 'finance';
const isTournamentsShell = activeShell === 'tournaments';

  const fontStylesheet = isTournamentsShell
  ? 'https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=DM+Sans:wght@400;500;600;700;800&display=swap'
  : isFinanceShell
    ? 'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Manrope:wght@500;600;700&display=swap'
    : 'https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap';

const themeColor = isTournamentsShell
  ? '#0A0F12'
  : isFinanceShell
    ? '#F3F6FD'
    : '#F4F1EB';

const bodyBgClass = isTournamentsShell
  ? 'bg-[#0A0F12] text-[#F6F8EE]'
  : isFinanceShell
    ? 'bg-[#F3F6FD]'
    : 'bg-bg-base';
---

<!doctype html>
<html
  lang={site.locale}
  class:list={[
    'bg-bg-base text-text',
    isFinanceShell && 'finance-app-html',
    isTournamentsShell && 'tournaments-app-html',
  ]}
>
  <head>
    <meta charset="utf-8" />
    {isFinanceShell ? (
      <style is:inline>
        html.finance-app-html, html.finance-app-html body { background: #f3f6fd; }
        .foco-boot-static {
          box-sizing: border-box; display: flex; min-height: 72dvh; padding: 7rem 1.5rem 4rem;
          align-items: center; justify-content: flex-start; flex-direction: column;
          color: #14213b; background: #f3f6fd; text-align: center;
          font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }
        .foco-boot-static img { width: 68px; height: 68px; border-radius: 19px; box-shadow: 0 9px 26px #14213b1a; }
        .foco-boot-static strong { margin-top: 1.2rem; font-size: 1.35rem; letter-spacing: -.035em; font-weight: 800; }
        .foco-boot-static span { margin-top: .35rem; font-size: .85rem; font-weight: 500; color: #536380; }
        .foco-boot-track { margin-top: 1.8rem; height: 4px; width: min(11rem, 70vw); border-radius: 999px; background: #dce5f5; overflow: hidden; }
        .foco-boot-track i { display: block; width: 40%; height: 100%; background: #2463eb; border-radius: inherit; animation: foco-boot-move 1.1s ease-in-out infinite alternate; }
        @keyframes foco-boot-move { from { transform: translateX(0); } to { transform: translateX(150%); } }
        @media (prefers-reduced-motion: reduce) { .foco-boot-track i { animation: none; width: 100%; } }
      </style>
    ) : null}
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href={fontStylesheet}
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href={fontStylesheet} />
    </noscript>

    <meta name="theme-color" content={themeColor} />
    {
      isFinanceShell ? (
        <>
          {/* Caching de Foco: cabeceras HTTP de Vercel, sin meta contradictorias. */}
          <meta name="apple-mobile-web-app-capable" content="yes" />
          <meta name="apple-mobile-web-app-title" content="Foco financiero" />
          <meta name="apple-mobile-web-app-status-bar-style" content="default" />
          <link rel="manifest" href="/foco-financiero.webmanifest?v=4" />
          <script is:inline>
            window.addEventListener('beforeinstallprompt', (event) => {
              event.preventDefault();
              window.__focoInstallPrompt = event;
              window.dispatchEvent(new Event('foco-install-available'));
            });
            // Legacy SW no longer needed: this app requires online Supabase.
          </script>
          <script>
            import { cleanupLegacyFinanceWorker } from '@/lib/finance/pwaCleanup';
            if (document.documentElement.classList.contains('finance-app-html') && 'serviceWorker' in navigator) {
              void cleanupLegacyFinanceWorker(navigator.serviceWorker, window.location.origin);
            }
          </script>
        </>
      ) : null
    }
    {
      isTournamentsShell ? (
        <>
          <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
          <meta http-equiv="Pragma" content="no-cache" />
          <meta name="apple-mobile-web-app-capable" content="yes" />
          <meta name="apple-mobile-web-app-title" content="Noche FC" />
          <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
          <link rel="manifest" href="/torneos.webmanifest?v=1" />
        </>
      ) : null
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {isFinanceShell ? (
      <>
        <link rel="icon" type="image/png" sizes="32x32" href="/foco/favicon-32.png?v=4" />
        <link rel="icon" type="image/png" sizes="16x16" href="/foco/favicon-16.png?v=4" />
        <link rel="apple-touch-icon" sizes="180x180" href="/foco/apple-touch-icon.png?v=4" />
      </>
    ) : (
      <>
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
      </>
    )}
    {!activeShell ? <link rel="manifest" href="/site.webmanifest" /> : null}
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body
    class:list={[
      'relative min-h-dvh overflow-x-clip text-text',
      bodyBgClass,
    ]}
  >
    {!activeShell ? <AmbientBackdrop /> : null}
    {
      !activeShell ? (
        <a href="#main" class="skip-link">
          Saltar al contenido
        </a>
      ) : null
    }
    <div class="relative z-[1] flex min-h-dvh flex-col">
      {!activeShell ? (caseStudyHeader ? <CaseStudyHeader /> : <Header />) : null}
      <main
        id="main"
        class:list={[
          'flex min-h-0 flex-1 flex-col justify-start',
          !activeShell && 'site-shell-main',
        ]}
      >
        <slot />
      </main>
      {!activeShell ? <Footer /> : null}
    </div>

    {
      activeShell ? null : (
        <script>
          import '@/scripts/fm-anchor-navigation.ts';
          import '@/scripts/smooth-scroll.ts';
        </script>
      )
    }
  </body>
</html>
