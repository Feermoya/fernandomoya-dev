---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import AmbientBackdrop from '@/components/layout/AmbientBackdrop.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import ScrollMotion from '@/components/layout/ScrollMotion.astro';
import { site } from '@/data/site';
import { absoluteUrl } from '@/utils/seo';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImagePath?: string;
  noindex?: boolean;
  /** Shell de app: sin nav del sitio, manifest PWA dedicado, fondo foco financiero. */
  appShell?: boolean;
}

const {
  title,
  description,
  path = '/',
  ogImagePath,
  noindex = false,
  appShell = false,
} = Astro.props;
const canonical = absoluteUrl(path);
const ogImage = ogImagePath ? absoluteUrl(ogImagePath) : undefined;
---

<!doctype html>
<html
  lang={site.locale}
  class:list={['bg-bg-base text-text', appShell && 'finance-app-html']}
>
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={appShell ? '#F6F8FB' : '#070707'} />
    {
      appShell ? (
        <>
          <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
          <meta http-equiv="Pragma" content="no-cache" />
          <meta name="apple-mobile-web-app-capable" content="yes" />
          <meta name="apple-mobile-web-app-title" content="Foco financiero" />
          <meta name="apple-mobile-web-app-status-bar-style" content="default" />
          <link rel="manifest" href="/foco-financiero.webmanifest?v=3" />
        </>
      ) : null
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {!appShell ? <link rel="manifest" href="/site.webmanifest" /> : null}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Astro 6: transiciones de vista vía `ClientRouter` (antes `ViewTransitions` en guías antiguas). -->
    <ClientRouter />
  </head>
  <body
    class:list={[
      'relative min-h-dvh overflow-x-clip text-text',
      appShell ? 'bg-[#F6F8FB]' : 'bg-bg-base',
    ]}
  >
    {
      !appShell ? (
        <div
          id="page-transition-overlay"
          class="page-transition-overlay pointer-events-none fixed inset-0 z-[200]"
          aria-hidden="true"
        >
          <div class="page-transition-overlay-inner">
            <div class="page-transition-overlay-logo" aria-hidden="true">
              <span class="page-transition-overlay-letter">F</span>
              <span class="page-transition-overlay-letter">M</span>
            </div>
          </div>
        </div>
      ) : null
    }

    {!appShell ? <AmbientBackdrop /> : null}
    <div class="relative z-[1] flex min-h-dvh flex-col">
      {!appShell ? <ScrollMotion /> : null}
      {!appShell ? <Header /> : null}
      <main
        id="main"
        class:list={['flex min-h-0 flex-1 flex-col justify-start !pt-0', !appShell && 'site-shell-main']}
      >
        <slot />
      </main>
      {!appShell ? <Footer /> : null}
    </div>

    {
      appShell ? null : (
        <script>
          import '@/scripts/fm-page-transition.ts';
          import '@/scripts/fm-lenis.ts';
          import '@/scripts/fm-split-text.ts';
        </script>
      )
    }
  </body>
</html>
