---
import '@/styles/global.css';
import AmbientBackdrop from '@/components/layout/AmbientBackdrop.astro';
import Header from '@/components/layout/Header.astro';
import CaseStudyHeader from '@/components/layout/CaseStudyHeader.astro';
import Footer from '@/components/layout/Footer.astro';
import { site } from '@/data/site';
import { absoluteUrl } from '@/utils/seo';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImagePath?: string;
  noindex?: boolean;
  /** Shell de app: sin nav del sitio, manifest PWA dedicado, fondo foco financiero. */
  appShell?: boolean;
  /** Caso de estudio: header con volver al trabajo. */
  caseStudyHeader?: boolean;
}

const {
  title,
  description,
  path = '/',
  ogImagePath,
  noindex = false,
  appShell = false,
  caseStudyHeader = false,
} = Astro.props;
const canonical = absoluteUrl(path);
const ogImage = ogImagePath ? absoluteUrl(ogImagePath) : undefined;

const fontStylesheet = appShell
  ? 'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap'
  : 'https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap';
---

<!doctype html>
<html
  lang={site.locale}
  class:list={['bg-bg-base text-text', appShell && 'finance-app-html']}
>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href={fontStylesheet}
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href={fontStylesheet} />
    </noscript>

    <meta name="theme-color" content={appShell ? '#F6F8FB' : '#F4F1EB'} />
    {
      appShell ? (
        <>
          <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
          <meta http-equiv="Pragma" content="no-cache" />
          <meta name="apple-mobile-web-app-capable" content="yes" />
          <meta name="apple-mobile-web-app-title" content="Foco financiero" />
          <meta name="apple-mobile-web-app-status-bar-style" content="default" />
          <link rel="manifest" href="/foco-financiero.webmanifest?v=3" />
        </>
      ) : null
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {!appShell ? <link rel="manifest" href="/site.webmanifest" /> : null}
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body
    class:list={[
      'relative min-h-dvh overflow-x-clip text-text',
      appShell ? 'bg-[#F6F8FB]' : 'bg-bg-base',
    ]}
  >
    {!appShell ? <AmbientBackdrop /> : null}
    {
      !appShell ? (
        <a href="#main" class="skip-link">
          Saltar al contenido
        </a>
      ) : null
    }
    <div class="relative z-[1] flex min-h-dvh flex-col">
      {!appShell ? (caseStudyHeader ? <CaseStudyHeader /> : <Header />) : null}
      <main
        id="main"
        class:list={['flex min-h-0 flex-1 flex-col justify-start', !appShell && 'site-shell-main']}
      >
        <slot />
      </main>
      {!appShell ? <Footer /> : null}
    </div>

    {
      appShell ? null : (
        <script>
          import '@/scripts/fm-anchor-navigation.ts';
        </script>
      )
    }
  </body>
</html>
