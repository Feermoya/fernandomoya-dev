# =============================================================================
# Foco financiero — sincronización Supabase (opcional entre dispositivos)
# =============================================================================
# 1) Copiá este archivo como `.env.local` (no se sube a git).
# 2) En supabase.com → Project Settings → API:
#    - Project URL → PUBLIC_FINANCE_SUPABASE_URL
#    - anon / publishable key → PUBLIC_FINANCE_SUPABASE_ANON_KEY
# 3) Ejecutá supabase-finance-game.sql en el SQL Editor.
# 4) En Vercel → Settings → Environment Variables, pegá las mismas claves (Production).
# 5) Redeploy + reiniciá `npm run dev` en local.
#
# Evitar pausa del Free (~7 días sin actividad en la base):
# - Al entrar / recargar /foco-financiero la app hace ping a Supabase.
# - Vercel Cron llama /api/finance-keepalive una vez al día (usa las mismas env).
# - Si el proyecto ya está pausado, hay que darle Resume una vez en el dashboard.

PUBLIC_FINANCE_SUPABASE_URL=
PUBLIC_FINANCE_SUPABASE_ANON_KEY=

# CallMeBot (opcional). Lo más fácil es pegar la key en Foco → Avisos WhatsApp
# (se sincroniza a Supabase). Esta env queda solo como respaldo:
# CALLMEBOT_API_KEY=

# Búsqueda de tickers (Yahoo Finance search, sin API key).
# El frontend llama a /api/finance-symbol-search (nunca a Yahoo directo).
# Si Yahoo falla o rate-limita, usá “Agregar ticker manualmente” en Posiciones.

# --- Monitor automático (GitHub Actions → POST /api/finance-market-monitor) ---
# En Vercel (Production):
#   FINANCE_MONITOR_SECRET=<string largo aleatorio>
# En GitHub → Settings → Secrets and variables → Actions:
#   FINANCE_MONITOR_URL=https://www.fermoyadev.com.ar/api/finance-market-monitor
#   FINANCE_MONITOR_SECRET=<el mismo string>
# No subir estos valores al repo. El workflow llama solo al endpoint; la lógica vive en el proyecto.
# FINANCE_MONITOR_SECRET=

# =============================================================================
# Panel de cobros — Auth por clave (PIN)
# =============================================================================
# Sin Firebase / Google Cloud / proyecto nuevo.
# 1) Elegí una clave larga y solo tuya.
# 2) Pegala en PANEL_ACCESS_SECRET (NO uses prefijo PUBLIC_).
# 3) Opcional: PANEL_SESSION_SECRET distinto para firmar la cookie.
# 4) Misma variable en Vercel (Production).
#
# La cookie es httpOnly + sesión de browser (se corta al cerrar el navegador).
# /panel/* se valida en el servidor (middleware). La URL sola no alcanza.

PANEL_ACCESS_SECRET=
# PANEL_SESSION_SECRET=

# =============================================================================
# Panel de cobros — Supabase (datos; mismo proyecto que Foco)
# =============================================================================
# Auth del panel = PIN + cookie (arriba). Los datos NO usan Supabase Auth.
# CRUD futuro: endpoints SSR con service_role después de validar la cookie.
#
# 1) Project Settings → API → Project URL → SUPABASE_URL
#    (puede ser el mismo valor que PUBLIC_FINANCE_SUPABASE_URL)
# 2) service_role (secret) → SUPABASE_SERVICE_ROLE_KEY
#    NUNCA prefijo PUBLIC_. NUNCA al browser.
# 3) Ejecutá en SQL Editor:
#    supabase/migrations/20260814180000_panel_cobros.sql
# 4) Seed inicial (revisar antes de ejecutar; NO auto):
#    supabase/seed/panel_cobros_initial.sql
# 5) Historial pagos 2026 (revisar antes; NO auto):
#    supabase/seed/panel_cobros_history_2026.sql
# 6) Opcional demo (datos ficticios):
#    supabase/seed/panel_cobros_demo.sql
# 7) Misma SUPABASE_SERVICE_ROLE_KEY en Vercel (Production).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# URL canónica del sitio (ya usada por Astro). En local no hace falta.
# PUBLIC_SITE_URL=https://www.fermoyadev.com.ar
