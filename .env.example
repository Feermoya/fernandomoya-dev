# Foco financiero — sincronización Supabase (opcional).
# 1) Copiá este archivo como `.env.local` (no se sube a git).
# 2) Pegá URL y anon key desde Supabase → Project Settings → API.
# 3) Reiniciá `npm run dev`.

PUBLIC_FINANCE_SUPABASE_URL=
PUBLIC_FINANCE_SUPABASE_ANON_KEY=

# --- Recordatorio automático por WhatsApp (solo en Vercel, no en .env.local del sitio) ---
# Generá un secreto largo: openssl rand -hex 32
CRON_SECRET=

# API key de CallMeBot (gratis): https://www.callmebot.com/blog/free-api-whatsapp-messages/
# Enviá por WhatsApp al bot el mensaje que te indica la web para activar tu número.
CALLMEBOT_API_KEY=

# Activa el cron aunque en la app no marques "Activar recordatorios"
FINANCE_REMINDER_CRON_ENABLED=1

# Opcional si no cargás el número en la app (default: wa.me del sitio → 5492615760276)
FINANCE_REMINDER_PHONE=5492615760276
