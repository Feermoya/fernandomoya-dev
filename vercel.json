{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/finance-prices.mjs": {
      "maxDuration": 60
    },
    "api/finance-keepalive.mjs": {
      "maxDuration": 60
    },
    "api/finance-symbol-search.mjs": {
      "maxDuration": 15
    },
    "api/finance-cloud.mjs": {
      "maxDuration": 20
    },
    "api/finance-balanz.mjs": {
      "maxDuration": 20
    },
    "api/finance-vix.mjs": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/finance-keepalive",
      "schedule": "0 14 * * *"
    }
  ],
  "headers": [
    {
      "source": "/foco-financiero",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=120"
        }
      ]
    },
    {
      "source": "/foco-financiero/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=120"
        }
      ]
    },
    {
      "source": "/foco-financiero.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/panel",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/panel/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/torneos",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/torneos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/torneos.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/foco-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
